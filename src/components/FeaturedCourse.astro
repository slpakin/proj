---
---

<section class="py-20 bg-slate-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center max-w-2xl mx-auto mb-14">
      <span class="inline-block text-xs font-semibold text-brand-700 uppercase tracking-widest mb-3">Featured Training</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900">Latest release</h2>
      <p class="mt-4 text-lg text-slate-600">Our most comprehensive course yet — straight from production deployments.</p>
    </div>

    <div class="bg-white rounded-3xl border border-slate-200 shadow-xl overflow-hidden lg:grid lg:grid-cols-2">

      <!-- Left: Visual -->
      <div class="relative bg-brand-900 p-8 lg:p-12 flex flex-col justify-between min-h-[280px]">

        <!-- Background pattern -->
        <div class="absolute inset-0 opacity-10"
          style="background-image: radial-gradient(#93c5fd 1px, transparent 1px); background-size: 20px 20px;">
        </div>

        <!-- Badges -->
        <div class="relative flex items-center gap-2 flex-wrap">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-brand-700 border border-brand-600 rounded-full text-xs font-semibold text-white">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
            Expert Level
          </span>
          <span class="px-3 py-1 bg-brand-800 border border-brand-700 rounded-full text-xs font-medium text-brand-200">
            12 Hours
          </span>
          <span class="px-3 py-1 bg-emerald-800 border border-emerald-700 rounded-full text-xs font-medium text-emerald-200">
            New Release
          </span>
        </div>

        <!-- Title -->
        <div class="relative mt-8">
          <p class="text-brand-300 text-sm font-semibold uppercase tracking-wider mb-2">Oracle 23AI Series</p>
          <h3 class="text-white text-3xl font-extrabold leading-tight">
            Oracle 23AI Features<br />& Rollout Path
          </h3>
          <p class="mt-3 text-brand-200 text-sm leading-relaxed">
            A complete 12-hour deep-dive into Oracle 23AI — features, upgrade paths, AI Vector Search,
            JSON Relational Duality, and deployment strategies from real production rollouts.
          </p>
        </div>

        <!-- Play button -->
        <div class="relative mt-8">
          <a href="/signup" class="inline-flex items-center gap-3 px-5 py-3 bg-white text-brand-900 rounded-xl font-semibold text-sm hover:bg-brand-50 transition-colors shadow-lg">
            <span class="w-8 h-8 bg-brand-700 rounded-full flex items-center justify-center flex-shrink-0">
              <svg class="w-4 h-4 text-white ml-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path d="M6.3 2.841A1.5 1.5 0 004 4.11V15.89a1.5 1.5 0 002.3 1.269l9.344-5.89a1.5 1.5 0 000-2.538L6.3 2.84z"/>
              </svg>
            </span>
            Start Watching Free
          </a>
        </div>

      </div>

      <!-- Right: Module list -->
      <div class="p-8 lg:p-12">
        <h4 class="text-sm font-semibold text-slate-500 uppercase tracking-wider mb-6">Course Modules</h4>
        <ul class="space-y-4">
          {[
            { title: 'Oracle 23AI Architecture Overview',  duration: '1h 20m', locked: false },
            { title: 'AI Vector Search — Concepts & Labs', duration: '1h 45m', locked: false },
            { title: 'JSON Relational Duality Views',      duration: '1h 10m', locked: true  },
            { title: 'Schema Privileges & Security',       duration: '55m',    locked: true  },
            { title: 'In-Memory & Immutable Tables',       duration: '1h 05m', locked: true  },
            { title: 'Upgrade Paths: 19c / 21c → 23AI',   duration: '1h 30m', locked: true  },
            { title: 'Production Rollout Strategies',      duration: '2h 00m', locked: true  },
            { title: 'Troubleshooting & Performance',      duration: '1h 15m', locked: true  },
          ].map((mod, i) => (
            <li class="flex items-center gap-3">
              <span class={`flex-shrink-0 w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold ${mod.locked ? 'bg-slate-100 text-slate-400' : 'bg-brand-100 text-brand-700'}`}>
                {mod.locked
                  ? <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"/></svg>
                  : i + 1
                }
              </span>
              <span class={`text-sm flex-1 ${mod.locked ? 'text-slate-400' : 'text-slate-800 font-medium'}`}>{mod.title}</span>
              <span class="text-xs text-slate-400 font-mono">{mod.duration}</span>
            </li>
          ))}
        </ul>
        <div class="mt-8 pt-6 border-t border-slate-100">
          <a href="/signup" class="block w-full text-center py-3 px-4 bg-brand-700 text-white font-semibold rounded-xl hover:bg-brand-800 transition-colors text-sm">
            Unlock Full Course →
          </a>
        </div>
      </div>

    </div>

  </div>
</section>
