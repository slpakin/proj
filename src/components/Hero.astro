---
---

<section class="relative overflow-hidden min-h-screen flex items-center">

  <!-- Background video -->
  <video
    class="absolute inset-0 w-full h-full object-cover -z-20"
    autoplay muted loop playsinline
    poster="/hero-poster.jpg"
  >
    <source src="/hero-bg.mp4" type="video/mp4" />
  </video>

  <!-- Dark gradient overlay -->
  <div class="absolute inset-0 -z-10 bg-gradient-to-br from-slate-900/90 via-brand-900/80 to-slate-900/90"></div>

  <!-- Animated grid lines -->
  <div class="absolute inset-0 -z-10 opacity-10"
    style="background-image: linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px); background-size: 60px 60px;">
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 lg:py-32 w-full">
    <div class="lg:grid lg:grid-cols-2 lg:gap-16 items-center">

      <!-- Left: Text -->
      <div class="text-center lg:text-left">

        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-white/10 border border-white/20 backdrop-blur-sm rounded-full mb-6">
          <span class="w-2 h-2 bg-brand-400 rounded-full animate-pulse"></span>
          <span class="text-xs font-semibold text-brand-200 uppercase tracking-wider">14 Years of Oracle Expertise</span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white leading-tight tracking-tight">
          Master Oracle<br />
          <span class="text-brand-300">Database Excellence</span>
        </h1>

        <p class="mt-6 text-lg sm:text-xl text-slate-300 leading-relaxed max-w-xl mx-auto lg:mx-0">
          Production-proven workflows for DBAs who need results, not theory.
          Covering RAC, ASM, Exadata, ODA, performance tuning, and disaster recovery
          from Oracle 11g through 23AI.
        </p>

        <!-- CTAs -->
        <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center lg:justify-start">
          <a href="/#trainings" class="inline-flex items-center justify-center gap-2 px-6 py-3 text-base font-semibold text-white bg-brand-600 rounded-xl hover:bg-brand-500 transition-colors shadow-lg shadow-brand-900/40">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.347a1.125 1.125 0 010 1.972l-11.54 6.347a1.125 1.125 0 01-1.667-.986V5.653z" />
            </svg>
            Explore Trainings
          </a>
          <a href="/#blog" class="inline-flex items-center justify-center gap-2 px-6 py-3 text-base font-semibold text-white bg-white/10 border border-white/25 backdrop-blur-sm rounded-xl hover:bg-white/20 transition-colors">
            Browse Articles
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
        </div>

        <!-- Trust indicators -->
        <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
          {[
            '500+ professionals trained',
            'Oracle 11g → 23AI coverage',
            'Hands-on labs & real logs',
          ].map(item => (
            <div class="flex items-center gap-2 text-sm text-slate-300">
              <svg class="w-4 h-4 text-brand-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"/>
              </svg>
              {item}
            </div>
          ))}
        </div>

      </div>

      <!-- Right: Visual card -->
      <div class="hidden lg:block mt-12 lg:mt-0">
        <div class="relative">

          <!-- Main card -->
          <div class="bg-slate-900/80 backdrop-blur-md rounded-2xl shadow-2xl border border-white/10 p-6 max-w-md ml-auto">
            <div class="flex items-center gap-2 mb-4">
              <div class="w-3 h-3 bg-red-400 rounded-full"></div>
              <div class="w-3 h-3 bg-yellow-400 rounded-full"></div>
              <div class="w-3 h-3 bg-green-400 rounded-full"></div>
              <span class="ml-2 text-xs font-mono text-slate-400">oracle-perf-lab.sql</span>
            </div>
            <pre class="text-xs font-mono leading-relaxed text-slate-300 overflow-x-auto"><code><span class="text-purple-400">SELECT</span> s.sql_id,
       s.elapsed_time / 1000000 <span class="text-slate-500">AS</span> secs,
       s.executions,
       s.buffer_gets / NULLIF(s.executions, 0)
         <span class="text-slate-500">AS</span> gets_per_exec
<span class="text-purple-400">FROM</span>   v$sql s
<span class="text-slate-500">JOIN</span>   dba_hist_sqlstat h
       <span class="text-slate-500">ON</span> s.sql_id = h.sql_id
<span class="text-purple-400">WHERE</span>  s.elapsed_time > <span class="text-emerald-400">5000000</span>
<span class="text-purple-400">ORDER</span> <span class="text-purple-400">BY</span> secs <span class="text-purple-400">DESC</span>
<span class="text-slate-500">FETCH FIRST</span> <span class="text-emerald-400">20</span> <span class="text-slate-500">ROWS ONLY</span>;</code></pre>
            <div class="mt-4 pt-4 border-t border-white/10 flex items-center justify-between">
              <span class="text-xs text-slate-500 font-mono">20 rows returned in 0.003s</span>
              <span class="inline-flex items-center gap-1 text-xs font-semibold text-emerald-400 bg-emerald-900/40 border border-emerald-700/40 px-2 py-0.5 rounded-full">
                <span class="w-1.5 h-1.5 bg-emerald-400 rounded-full"></span>
                AWR Analysis
              </span>
            </div>
          </div>

          <!-- Floating badge 1 -->
          <div class="absolute -top-5 -left-5 bg-slate-900/80 backdrop-blur-md rounded-xl shadow-lg border border-white/10 p-3 flex items-center gap-3">
            <div class="w-10 h-10 bg-brand-800/60 rounded-lg flex items-center justify-center">
              <svg class="w-5 h-5 text-brand-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
              </svg>
            </div>
            <div>
              <p class="text-xs font-bold text-white">99.8%</p>
              <p class="text-xs text-slate-400">Performance uplift</p>
            </div>
          </div>

          <!-- Floating badge 2 -->
          <div class="absolute -bottom-5 -right-5 bg-slate-900/80 backdrop-blur-md rounded-xl shadow-lg border border-white/10 p-3 flex items-center gap-3">
            <div class="w-10 h-10 bg-emerald-900/60 rounded-lg flex items-center justify-center">
              <svg class="w-5 h-5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-7.007 11.55A5.981 5.981 0 006.75 15.75v-1.5" />
              </svg>
            </div>
            <div>
              <p class="text-xs font-bold text-white">100+</p>
              <p class="text-xs text-slate-400">Implementations</p>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
