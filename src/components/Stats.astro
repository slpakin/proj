---

<section class="bg-brand-900 py-14">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-4">
      {stats.map((stat) => (
        <div class="text-center">
          <div class="inline-flex items-center justify-center w-12 h-12 bg-brand-800 rounded-xl mb-3 mx-auto">
            <svg class="w-6 h-6 text-brand-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d={stat.icon} />
            </svg>
          </div>
          <div class="text-3xl lg:text-4xl font-extrabold text-white tracking-tight">{stat.value}</div>
          <div class="mt-1 text-sm font-medium text-brand-200">{stat.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>
