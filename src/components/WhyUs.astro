<section id="blog" class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center max-w-2xl mx-auto mb-14">
      <span class="inline-block text-xs font-semibold text-brand-700 uppercase tracking-widest mb-3">Why AkinsMedia</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900">Built by a DBA, for DBAs</h2>
      <p class="mt-4 text-lg text-slate-600">
        No fluff, no recycled documentation. Just battle-tested knowledge from 14 years of Oracle production work.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {reasons.map((reason) => (
        <div class="p-6 rounded-2xl border border-slate-200 hover:border-brand-300 hover:shadow-md transition-all duration-200 group">
          <div class="w-10 h-10 bg-brand-50 rounded-lg flex items-center justify-center mb-4 group-hover:bg-brand-100 transition-colors">
            <svg class="w-5 h-5 text-brand-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d={reason.icon} />
            </svg>
          </div>
          <h3 class="font-bold text-slate-900 mb-2">{reason.title}</h3>
          <p class="text-sm text-slate-600 leading-relaxed">{reason.body}</p>
        </div>
      ))}
    </div>

  </div>
</section>
