---
// Colour maps — defined in frontmatter to avoid TS generic syntax inside JSX
const featureCardBg: Record<string, string> = {
  indigo: 'bg-nutries-indigo-50 border-nutries-indigo-100 hover:border-nutries-indigo-300',
  green:  'bg-nutries-green-50  border-nutries-green-100  hover:border-nutries-green-300',
  brown:  'bg-nutries-brown-50  border-nutries-brown-100  hover:border-nutries-brown-300',
  red:    'bg-nutries-red-50    border-nutries-red-100    hover:border-nutries-red-300',
};
const featureIconBg: Record<string, string> = {
  indigo: 'bg-nutries-indigo-100 text-nutries-indigo-700',
  green:  'bg-nutries-green-100  text-nutries-green-700',
  brown:  'bg-nutries-brown-100  text-nutries-brown-700',
  red:    'bg-nutries-red-100    text-nutries-red-700',
};
const stepNumBg: Record<string, string> = {
  indigo: 'bg-nutries-indigo-600 shadow-glow-i',
  green:  'bg-nutries-green-600  shadow-glow-g',
  brown:  'bg-nutries-brown-600',
};
const stepTxtColor: Record<string, string> = {
  indigo: 'text-nutries-indigo-700',
  green:  'text-nutries-green-700',
  brown:  'text-nutries-brown-700',
};
---

<section id="how-it-works" class="py-24 bg-section-warm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header -->
    <div class="text-center mb-16">
      <span class="inline-block px-4 py-1.5 rounded-full bg-nutries-indigo-100 text-nutries-indigo-700 text-sm font-semibold mb-4">
        Why Nutries
      </span>
      <h2 class="font-display text-4xl sm:text-5xl font-bold text-nutries-grey-900 mb-4">
        Engineered for<br/><span class="text-nutries-indigo-700">Real Kitchens</span>
      </h2>
      <p class="text-nutries-grey-500 text-lg max-w-2xl mx-auto">
        Every feature of the Chef Preserve was designed with daily home cooking in mind —
        from the one-touch seal to the whisper-quiet motor.
      </p>
    </div>

    <!-- Features grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
      {[
        {
          icon: '⚡',
          color: 'indigo',
          title: 'One-Touch Sealing',
          body: 'Place your bag, press the single button — a perfect airtight seal forms in under 10 seconds. No settings to fiddle with.'
        },
        {
          icon: '🌿',
          color: 'green',
          title: 'Lock in Nutrients',
          body: '99% air removal stops oxidation, keeping vitamins and antioxidants intact for up to 5× longer than standard storage.'
        },
        {
          icon: '🎛️',
          color: 'brown',
          title: 'Moist & Dry Modes',
          body: 'Intelligent mode detection for soups, marinades, and wet foods as well as dry pantry staples — one device, every job.'
        },
        {
          icon: '📦',
          color: 'red',
          title: 'Built-in Roll Storage',
          body: 'Cut custom-length bags directly from the integrated roll compartment. No scissors needed, no mess on your counter.'
        },
        {
          icon: '🔇',
          color: 'indigo',
          title: 'Whisper-Quiet Motor',
          body: 'Under 55 dB during operation — quieter than normal conversation, so you can use it any time without disturbing others.'
        },
        {
          icon: '🧼',
          color: 'green',
          title: 'Easy Clean',
          body: 'Removable, dishwasher-safe drip tray and a wipe-clean exterior surface. Cleanup takes 30 seconds, not 30 minutes.'
        },
      ].map(f => (
        <div class={`rounded-2xl border p-6 transition-all duration-300 cursor-default hover:shadow-lg hover:-translate-y-1 ${featureCardBg[f.color]}`}>
          <div class={`w-12 h-12 rounded-xl flex items-center justify-center text-2xl mb-4 ${featureIconBg[f.color]}`}>
            {f.icon}
          </div>
          <h3 class="font-semibold text-nutries-grey-900 text-lg mb-2">{f.title}</h3>
          <p class="text-nutries-grey-500 text-sm leading-relaxed">{f.body}</p>
        </div>
      ))}
    </div>

    <!-- How it works steps -->
    <div class="bg-white rounded-3xl shadow-glass border border-nutries-grey-100 p-8 sm:p-12">
      <h3 class="font-display text-3xl font-bold text-nutries-grey-900 text-center mb-10">
        3 Steps to Perfect Preservation
      </h3>
      <div class="grid sm:grid-cols-3 gap-8 relative">
        <!-- Connecting line (desktop) -->
        <div class="hidden sm:block absolute top-8 left-[calc(16.67%+2rem)] right-[calc(16.67%+2rem)] h-0.5 bg-gradient-to-r from-nutries-indigo-200 via-nutries-green-200 to-nutries-brown-200"></div>

        {[
          { step: '01', color: 'indigo', title: 'Place Food in Bag', desc: 'Fill any compatible vacuum bag with fresh food, leaving 3 inches of space at the top.' },
          { step: '02', color: 'green',  title: 'Insert & Press', desc: 'Slide the open end into the Chef Preserve slot and press the single seal button.' },
          { step: '03', color: 'brown',  title: 'Done — Store or Freeze', desc: 'An airtight seal forms in 10 seconds. Refrigerate, freeze, or store at room temperature.' },
        ].map(s => (
          <div class="flex flex-col items-center text-center">
            <div class={`w-16 h-16 rounded-full flex items-center justify-center text-white font-bold text-xl mb-4 relative z-10 ${stepNumBg[s.color]}`}>
              {s.step}
            </div>
            <h4 class={`font-bold text-lg mb-2 ${stepTxtColor[s.color]}`}>{s.title}</h4>
            <p class="text-nutries-grey-500 text-sm leading-relaxed">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
