---
// Full-screen hero for Nutries homepage
---

<section class="relative min-h-screen flex items-center overflow-hidden bg-hero-gradient">

  <!-- Animated background blobs -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute -top-40 -left-40 w-96 h-96 bg-nutries-indigo-700/30 rounded-full blur-3xl animate-pulse-slow"></div>
    <div class="absolute top-1/3 right-0 w-80 h-80 bg-nutries-green-700/25 rounded-full blur-3xl animate-pulse-slow" style="animation-delay:1.5s"></div>
    <div class="absolute bottom-0 left-1/3 w-72 h-72 bg-nutries-red-700/20 rounded-full blur-3xl animate-pulse-slow" style="animation-delay:3s"></div>
  </div>

  <!-- Grid pattern overlay -->
  <div class="absolute inset-0 opacity-5"
    style="background-image: linear-gradient(rgba(255,255,255,.4) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.4) 1px, transparent 1px); background-size: 60px 60px;">
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 grid lg:grid-cols-2 gap-12 items-center">

    <!-- Text Content -->
    <div class="text-center lg:text-left">

      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 border border-white/20 backdrop-blur-sm text-white/90 text-sm font-medium mb-6">
        <span class="w-2 h-2 rounded-full bg-nutries-green-400 animate-pulse"></span>
        #1 Compact Vacuum Sealer for Home Kitchens
      </div>

      <!-- Headline -->
      <h1 class="font-display text-5xl sm:text-6xl lg:text-7xl font-bold text-white leading-[1.05] mb-6">
        Seal in<br/>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-nutries-green-300 via-nutries-green-400 to-nutries-green-300">Freshness.</span><br/>
        Lock in<br/>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-nutries-red-300 via-nutries-red-400 to-nutries-red-300">Nutrition.</span>
      </h1>

      <p class="text-white/75 text-lg sm:text-xl leading-relaxed max-w-lg mx-auto lg:mx-0 mb-8">
        The Chef Preserve Compact Vacuum Sealer removes 99% of air in seconds —
        extending your food's freshness up to <strong class="text-white font-semibold">5 times longer</strong>
        than conventional storage.
      </p>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
        <a
          href="/products/chef-preserve-compact-vacuum-sealer"
          class="group inline-flex items-center justify-center gap-2 px-8 py-4 rounded-2xl bg-btn-red text-white font-bold text-lg shadow-lg hover:shadow-glow-r transition-all duration-300 hover:-translate-y-1"
        >
          Shop Now — $149.99
          <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
        <a
          href="/#how-it-works"
          class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-2xl bg-white/10 hover:bg-white/20 border border-white/25 text-white font-semibold text-lg backdrop-blur-sm transition-all duration-300"
        >
          Watch It Work
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </a>
      </div>

      <!-- Trust Signals -->
      <div class="mt-10 flex flex-wrap gap-6 justify-center lg:justify-start">
        {[
          { icon: '⭐', label: '4.9/5', sub: '2,400+ reviews' },
          { icon: '🚚', label: 'Free shipping', sub: 'orders over $75' },
          { icon: '🔄', label: '30-day returns', sub: 'hassle-free' },
        ].map(t => (
          <div class="flex items-center gap-2">
            <span class="text-2xl">{t.icon}</span>
            <div>
              <p class="text-white font-semibold text-sm">{t.label}</p>
              <p class="text-white/60 text-xs">{t.sub}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Product Visual -->
    <div class="flex items-center justify-center lg:justify-end relative">

      <!-- Glow ring -->
      <div class="absolute w-[360px] h-[360px] lg:w-[480px] lg:h-[480px] rounded-full bg-gradient-to-br from-nutries-indigo-500/20 to-nutries-green-500/20 blur-2xl"></div>

      <!-- Glass product card -->
      <div class="relative animate-float z-10">
        <div class="relative w-72 h-72 sm:w-80 sm:h-80 lg:w-96 lg:h-96 rounded-3xl overflow-hidden
          bg-gradient-to-br from-white/20 to-white/5 border border-white/25
          backdrop-blur-md shadow-product flex items-center justify-center">

          <!-- Product SVG illustration -->
          <svg viewBox="0 0 300 300" xmlns="http://www.w3.org/2000/svg" class="w-4/5 h-4/5 drop-shadow-2xl">
            <!-- Base body -->
            <rect x="60" y="100" width="180" height="120" rx="16" fill="url(#body-grad)"/>
            <!-- Top panel -->
            <rect x="60" y="80" width="180" height="30" rx="10" fill="url(#top-grad)"/>
            <!-- Control panel -->
            <rect x="80" y="110" width="140" height="50" rx="8" fill="rgba(255,255,255,0.1)"/>
            <!-- Buttons -->
            <circle cx="110" cy="135" r="12" fill="url(#btn1-grad)"/>
            <circle cx="150" cy="135" r="12" fill="rgba(255,255,255,0.3)"/>
            <circle cx="190" cy="135" r="12" fill="url(#btn2-grad)"/>
            <!-- Button icons -->
            <text x="105" y="140" fill="white" font-size="12" font-family="sans-serif">▶</text>
            <text x="146" y="140" fill="white" font-size="10" font-family="sans-serif" opacity="0.8">⟳</text>
            <text x="185" y="140" fill="white" font-size="10" font-family="sans-serif">✦</text>
            <!-- Slot -->
            <rect x="80" y="175" width="140" height="10" rx="5" fill="rgba(0,0,0,0.2)"/>
            <rect x="80" y="175" width="140" height="10" rx="5" fill="url(#slot-grad)" opacity="0.6"/>
            <!-- Brand text -->
            <text x="150" y="95" text-anchor="middle" fill="white" font-size="11" font-family="Inter, sans-serif" font-weight="600" opacity="0.9">Chef Preserve</text>
            <!-- LED indicator -->
            <circle cx="210" cy="85" r="4" fill="#4ade80"/>
            <circle cx="210" cy="85" r="7" fill="#4ade80" opacity="0.3"/>
            <!-- Handle -->
            <rect x="230" y="110" width="20" height="80" rx="10" fill="url(#handle-grad)"/>
            <!-- Logo leaf -->
            <ellipse cx="150" cy="205" rx="50" ry="8" fill="rgba(0,0,0,0.15)"/>

            <defs>
              <linearGradient id="body-grad" x1="60" y1="100" x2="240" y2="220" gradientUnits="userSpaceOnUse">
                <stop stop-color="#e8eaf6"/>
                <stop offset="1" stop-color="#c5cae9"/>
              </linearGradient>
              <linearGradient id="top-grad" x1="60" y1="80" x2="240" y2="110" gradientUnits="userSpaceOnUse">
                <stop stop-color="#4f46e5"/>
                <stop offset="1" stop-color="#3730a3"/>
              </linearGradient>
              <linearGradient id="btn1-grad" x1="98" y1="123" x2="122" y2="147" gradientUnits="userSpaceOnUse">
                <stop stop-color="#ef4444"/>
                <stop offset="1" stop-color="#b91c1c"/>
              </linearGradient>
              <linearGradient id="btn2-grad" x1="178" y1="123" x2="202" y2="147" gradientUnits="userSpaceOnUse">
                <stop stop-color="#22c55e"/>
                <stop offset="1" stop-color="#15803d"/>
              </linearGradient>
              <linearGradient id="slot-grad" x1="80" y1="175" x2="220" y2="185" gradientUnits="userSpaceOnUse">
                <stop stop-color="#4f46e5" stop-opacity="0.8"/>
                <stop offset="1" stop-color="#22c55e" stop-opacity="0.8"/>
              </linearGradient>
              <linearGradient id="handle-grad" x1="230" y1="110" x2="250" y2="190" gradientUnits="userSpaceOnUse">
                <stop stop-color="#9ca3af"/>
                <stop offset="1" stop-color="#6b7280"/>
              </linearGradient>
            </defs>
          </svg>

          <!-- Glossy overlay -->
          <div class="absolute inset-0 bg-gradient-to-br from-white/15 via-transparent to-transparent pointer-events-none rounded-3xl"></div>
        </div>

        <!-- Floating badges -->
        <div class="absolute -top-4 -left-4 bg-white rounded-2xl shadow-lg px-4 py-2 flex items-center gap-2">
          <span class="text-xl">⚡</span>
          <div>
            <p class="text-xs text-nutries-grey-500 font-medium">Seals in</p>
            <p class="text-sm font-bold text-nutries-grey-900">10 seconds</p>
          </div>
        </div>

        <div class="absolute -bottom-4 -right-4 bg-nutries-green-600 rounded-2xl shadow-lg px-4 py-2 text-white">
          <p class="text-xs font-medium opacity-80">Freshness</p>
          <p class="text-lg font-bold">5× Longer</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-white/50 animate-bounce">
    <span class="text-xs font-medium tracking-widest uppercase">Scroll</span>
    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
    </svg>
  </div>
</section>
