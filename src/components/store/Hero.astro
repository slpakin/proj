---
// Full-screen hero for Nutries homepage
---

<section class="relative min-h-screen flex items-center overflow-hidden bg-hero-gradient">

  <!-- Animated background blobs -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute -top-40 -left-40 w-96 h-96 bg-nutries-indigo-700/30 rounded-full blur-3xl animate-pulse-slow"></div>
    <div class="absolute top-1/3 right-0 w-80 h-80 bg-nutries-green-700/25 rounded-full blur-3xl animate-pulse-slow" style="animation-delay:1.5s"></div>
    <div class="absolute bottom-0 left-1/3 w-72 h-72 bg-nutries-red-700/20 rounded-full blur-3xl animate-pulse-slow" style="animation-delay:3s"></div>
  </div>

  <!-- Grid pattern overlay -->
  <div class="absolute inset-0 opacity-5"
    style="background-image: linear-gradient(rgba(255,255,255,.4) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.4) 1px, transparent 1px); background-size: 60px 60px;">
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 grid lg:grid-cols-2 gap-12 items-center">

    <!-- Text Content -->
    <div class="text-center lg:text-left">

      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 border border-white/20 backdrop-blur-sm text-white/90 text-sm font-medium mb-6">
        <span class="w-2 h-2 rounded-full bg-nutries-green-400 animate-pulse"></span>
        Award-Winning Compact Vacuum Sealer · Ships Worldwide
      </div>

      <!-- Headline -->
      <h1 class="font-display text-5xl sm:text-6xl lg:text-7xl font-bold text-white leading-[1.05] mb-6">
        Seal in<br/>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-nutries-green-300 via-nutries-green-400 to-nutries-green-300">Freshness.</span><br/>
        Lock in<br/>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-nutries-red-300 via-nutries-red-400 to-nutries-red-300">Nutrition.</span>
      </h1>

      <p class="text-white/75 text-lg sm:text-xl leading-relaxed max-w-lg mx-auto lg:mx-0 mb-8">
        The Chef Preserve removes 99% of air in under 10 seconds, stopping spoilage
        at the molecular level — keeping your food fresh for up to
        <strong class="text-white font-semibold">5× longer</strong> than standard storage.
        Less waste. More flavour. Every week.
      </p>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
        <a
          href="/products/chef-preserve-compact-vacuum-sealer"
          class="group inline-flex items-center justify-center gap-2 px-8 py-4 rounded-2xl bg-btn-red text-white font-bold text-lg shadow-lg hover:shadow-glow-r transition-all duration-300 hover:-translate-y-1"
        >
          Shop Now — $149.99
          <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
        <a
          href="/#how-it-works"
          class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-2xl bg-white/10 hover:bg-white/20 border border-white/25 text-white font-semibold text-lg backdrop-blur-sm transition-all duration-300"
        >
          Watch It Work
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </a>
      </div>

      <!-- Trust Signals -->
      <div class="mt-10 flex flex-wrap gap-6 justify-center lg:justify-start">
        {[
          { icon: '⭐', label: '4.9 / 5.0', sub: '3,200+ verified reviews' },
          { icon: '🌍', label: 'Ships Worldwide', sub: 'to 40+ countries' },
          { icon: '🔄', label: '30-Day Returns', sub: 'no questions asked' },
        ].map(t => (
          <div class="flex items-center gap-2">
            <span class="text-2xl">{t.icon}</span>
            <div>
              <p class="text-white font-semibold text-sm">{t.label}</p>
              <p class="text-white/60 text-xs">{t.sub}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Product Visual -->
    <div class="flex items-center justify-center lg:justify-end relative">

      <!-- Glow ring -->
      <div class="absolute w-[360px] h-[360px] lg:w-[480px] lg:h-[480px] rounded-full bg-gradient-to-br from-nutries-indigo-500/20 to-nutries-green-500/20 blur-2xl"></div>

      <!-- Product photo card -->
      <div class="relative animate-float z-10">
        <div class="relative w-72 h-72 sm:w-80 sm:h-80 lg:w-[420px] lg:h-[420px] rounded-3xl overflow-hidden
          border border-white/25 shadow-product">

          <!-- Real product photo -->
          <img
            src="/images/products/product-avocado.jpg"
            alt="Chef Preserve vacuum sealer sealing avocados"
            class="w-full h-full object-cover"
          />

          <!-- Glossy overlay -->
          <div class="absolute inset-0 bg-gradient-to-br from-white/10 via-transparent to-transparent pointer-events-none rounded-3xl"></div>
        </div>

        <!-- Floating badges -->
        <div class="absolute -top-4 -left-4 bg-white rounded-2xl shadow-lg px-4 py-2 flex items-center gap-2">
          <span class="text-xl">⚡</span>
          <div>
            <p class="text-xs text-nutries-grey-500 font-medium">Seals in</p>
            <p class="text-sm font-bold text-nutries-grey-900">10 seconds</p>
          </div>
        </div>

        <div class="absolute -bottom-4 -right-4 bg-nutries-green-600 rounded-2xl shadow-lg px-4 py-2 text-white">
          <p class="text-xs font-medium opacity-80">Freshness</p>
          <p class="text-lg font-bold">5× Longer</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-white/50 animate-bounce">
    <span class="text-xs font-medium tracking-widest uppercase">Scroll</span>
    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
    </svg>
  </div>
</section>
