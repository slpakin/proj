---
const reviews = [
  {
    name: 'Amara O.',
    location: 'London, UK',
    rating: 5,
    title: 'The smartest kitchen purchase I have made',
    body: "I batch-cook every weekend and the Chef Preserve has genuinely cut my food waste in half. Asparagus, soft cheese, leftover stew — everything keeps far longer. The one-button seal is brilliant. My whole family uses it now.",
    avatar: 'A',
    color: 'indigo',
    verified: true,
  },
  {
    name: 'Kenji M.',
    location: 'Tokyo, Japan',
    rating: 5,
    title: 'Exceptional build quality, zero compromise',
    body: "I compared four vacuum sealers before choosing this. The motor is whisper-quiet — under 55 dB, exactly as advertised. Sealed fresh tuna and it was still sashimi-grade after 11 days refrigerated. Outstanding.",
    avatar: 'K',
    color: 'green',
    verified: true,
  },
  {
    name: 'Sofia B.',
    location: 'São Paulo, Brazil',
    rating: 5,
    title: 'Saves money every single week',
    body: "Supermarket trips used to go bad so fast in the heat here. Since getting the Chef Preserve, I buy in bulk and nothing spoils. The moist-mode handles my sofrito and açaí perfectly. Cannot imagine cooking without it.",
    avatar: 'S',
    color: 'red',
    verified: true,
  },
  {
    name: 'Luca F.',
    location: 'Milan, Italy',
    rating: 5,
    title: 'Restaurante quality at home',
    body: "I sous-vide at home and this is the only compact sealer that handles both wet marinades and dry goods reliably. Bought the Pro Bundle — worth every cent. Premium feel, professional results. My nonna approved.",
    avatar: 'L',
    color: 'brown',
    verified: true,
  },
];

const colorMap: Record<string, string> = {
  indigo: 'bg-nutries-indigo-600',
  green:  'bg-nutries-green-600',
  red:    'bg-nutries-red-600',
  brown:  'bg-nutries-brown-600',
};
---

<section class="py-24 bg-white overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header -->
    <div class="text-center mb-14">
      <span class="inline-block px-4 py-1.5 rounded-full bg-nutries-brown-50 text-nutries-brown-700 text-sm font-semibold border border-nutries-brown-200 mb-4">
        Customer Love
      </span>
      <h2 class="font-display text-4xl sm:text-5xl font-bold text-nutries-grey-900 mb-4">
        Trusted by Home Cooks<br/>Across 40+ Countries
      </h2>
      <!-- Aggregate stars -->
      <div class="flex items-center justify-center gap-2">
        <div class="flex gap-1 text-nutries-brown-400 text-2xl">
          {'★★★★★'.split('').map(s => <span>{s}</span>)}
        </div>
        <span class="text-nutries-grey-700 font-bold text-lg">4.9</span>
        <span class="text-nutries-grey-400 text-sm">/ 5.0 average rating</span>
      </div>
    </div>

    <!-- Review cards -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {reviews.map(r => (
        <div class="flex flex-col bg-nutries-grey-50 rounded-2xl p-6 border border-nutries-grey-100 hover:shadow-md transition-shadow duration-300">
          <!-- Stars -->
          <div class="flex gap-0.5 text-nutries-brown-400 text-sm mb-3">
            {'★★★★★'.split('').map(s => <span>{s}</span>)}
          </div>
          <h4 class="font-bold text-nutries-grey-900 text-sm mb-2">"{r.title}"</h4>
          <p class="text-nutries-grey-500 text-sm leading-relaxed flex-1">{r.body}</p>
          <!-- Author -->
          <div class="flex items-center gap-3 mt-5 pt-4 border-t border-nutries-grey-200">
            <div class={`w-9 h-9 rounded-full flex items-center justify-center text-white font-bold text-sm flex-shrink-0 ${colorMap[r.color]}`}>
              {r.avatar}
            </div>
            <div>
              <p class="text-nutries-grey-900 text-sm font-semibold">{r.name}</p>
              <p class="text-nutries-grey-400 text-xs">{r.location}</p>
            </div>
            {r.verified && (
              <div class="ml-auto flex items-center gap-1 text-nutries-green-600 text-xs font-medium">
                <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"/>
                </svg>
                Verified
              </div>
            )}
          </div>
        </div>
      ))}
    </div>

    <!-- Stats bar -->
    <div class="mt-14 grid grid-cols-2 sm:grid-cols-4 gap-6 bg-gradient-to-r from-nutries-indigo-900 to-nutries-green-900 rounded-3xl p-8">
      {[
        { value: '99%', label: 'Air removal — laboratory verified' },
        { value: '5×',  label: 'Longer freshness vs. standard storage' },
        { value: '10s', label: 'Seal time, start to finish' },
        { value: '2yr', label: 'Full product warranty' },
      ].map(s => (
        <div class="text-center">
          <p class="font-display text-4xl font-bold text-white mb-1">{s.value}</p>
          <p class="text-white/60 text-sm">{s.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
