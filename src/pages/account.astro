---
import StoreLayout from '../layouts/StoreLayout.astro';
import StoreNav    from '../components/store/StoreNav.astro';
import CartDrawer  from '../components/store/CartDrawer.astro';
import StoreFooter from '../components/store/StoreFooter.astro';
import { getSessionFromCookies } from '../lib/supabase';

const { user, client } = await getSessionFromCookies(Astro.cookies);
if (!user) return Astro.redirect('/login');

const { data: orders } = await client
  .from('orders')
  .select('*, order_items(*)')
  .eq('user_id', user.id)
  .order('created_at', { ascending: false })
  .limit(20);

const displayName = user.user_metadata?.full_name || user.email?.split('@')[0] || 'Customer';
const initials    = displayName.split(' ').map((w: string) => w[0]).join('').toUpperCase().slice(0, 2);

const statusColour: Record<string, string> = {
  paid:      'bg-green-100 text-green-700',
  pending:   'bg-yellow-100 text-yellow-700',
  shipped:   'bg-blue-100 text-blue-700',
  delivered: 'bg-nutries-green-100 text-nutries-green-700',
  cancelled: 'bg-red-100 text-red-700',
  refunded:  'bg-nutries-grey-100 text-nutries-grey-600',
};
---

<StoreLayout title="My Account — Nutries">
  <StoreNav />
  <CartDrawer />

  <main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 min-h-[70vh]">

    <!-- Header -->
    <div class="flex items-center gap-5 mb-10">
      <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-nutries-indigo-500 to-nutries-green-500 flex items-center justify-center text-white font-bold text-xl flex-shrink-0">
        {initials}
      </div>
      <div>
        <h1 class="font-display text-2xl font-bold text-nutries-grey-900">Welcome back, {displayName.split(' ')[0]}!</h1>
        <p class="text-nutries-grey-400 text-sm">{user.email}</p>
      </div>
      <form action="/api/auth/logout" method="POST" class="ml-auto">
        <button type="submit" class="px-4 py-2 rounded-xl border border-nutries-grey-200 text-nutries-grey-500 text-sm font-medium hover:border-red-300 hover:text-red-500 transition-colors">
          Log out
        </button>
      </form>
    </div>

    <!-- Quick links -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-10">
      {[
        { label: 'Shop Products', href: '/products', icon: 'M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z' },
        { label: 'My Cart',       href: '/cart',     icon: 'M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z' },
        { label: 'Checkout',      href: '/checkout',  icon: 'M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z' },
        { label: 'Help & FAQ',    href: '#',          icon: 'M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z' },
      ].map(item => (
        <a href={item.href}
          class="flex flex-col items-center gap-2 p-5 bg-white rounded-2xl border border-nutries-grey-100 hover:border-nutries-indigo-200 hover:shadow-sm transition-all group text-center">
          <div class="w-10 h-10 rounded-xl bg-nutries-indigo-50 group-hover:bg-nutries-indigo-100 flex items-center justify-center transition-colors">
            <svg class="w-5 h-5 text-nutries-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d={item.icon}/>
            </svg>
          </div>
          <span class="text-xs font-semibold text-nutries-grey-700">{item.label}</span>
        </a>
      ))}
    </div>

    <!-- Orders -->
    <div class="bg-white rounded-3xl border border-nutries-grey-100 overflow-hidden">
      <div class="px-6 py-5 border-b border-nutries-grey-100 flex items-center justify-between">
        <h2 class="font-bold text-nutries-grey-900">Order History</h2>
        <span class="text-sm text-nutries-grey-400">{orders?.length || 0} order{orders?.length !== 1 ? 's' : ''}</span>
      </div>

      {!orders || orders.length === 0 ? (
        <div class="flex flex-col items-center py-16 text-center px-6">
          <div class="w-16 h-16 rounded-2xl bg-nutries-grey-50 flex items-center justify-center mb-4">
            <svg class="w-8 h-8 text-nutries-grey-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
            </svg>
          </div>
          <p class="text-nutries-grey-500 font-medium mb-1">No orders yet</p>
          <p class="text-nutries-grey-400 text-sm mb-5">When you place an order it will appear here.</p>
          <a href="/products" class="px-5 py-2.5 rounded-xl bg-btn-indigo text-white text-sm font-semibold hover:shadow-glow-i transition-all">
            Start Shopping →
          </a>
        </div>
      ) : (
        <div class="divide-y divide-nutries-grey-100">
          {orders.map(order => {
            const date  = new Date(order.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
            const total = (order.total_cents / 100).toFixed(2);
            const colour = statusColour[order.status] || 'bg-nutries-grey-100 text-nutries-grey-600';
            return (
              <div class="px-6 py-4 flex items-center gap-4">
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-semibold text-nutries-grey-900">Order #{order.id.slice(-8).toUpperCase()}</p>
                  <p class="text-xs text-nutries-grey-400 mt-0.5">{date} · {order.order_items?.length || 0} item{order.order_items?.length !== 1 ? 's' : ''}</p>
                </div>
                <span class={`px-2.5 py-1 rounded-full text-xs font-semibold capitalize ${colour}`}>{order.status}</span>
                <span class="text-sm font-bold text-nutries-grey-900 whitespace-nowrap">${total}</span>
              </div>
            );
          })}
        </div>
      )}
    </div>

  </main>

  <StoreFooter />
</StoreLayout>
