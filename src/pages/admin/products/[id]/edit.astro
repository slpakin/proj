---
import StoreLayout from '../../../../layouts/StoreLayout.astro';
import StoreNav    from '../../../../components/store/StoreNav.astro';
import CartDrawer  from '../../../../components/store/CartDrawer.astro';
import StoreFooter from '../../../../components/store/StoreFooter.astro';
import { getSessionFromCookies, isAdmin } from '../../../../lib/supabase';
import { createClient } from '@supabase/supabase-js';

const { user } = await getSessionFromCookies(Astro.cookies);
if (!user || !isAdmin(user.email)) return Astro.redirect('/login');

const { id } = Astro.params;

const serviceClient = createClient(
  import.meta.env.SUPABASE_URL,
  import.meta.env.SUPABASE_SERVICE_ROLE_KEY,
  { auth: { autoRefreshToken: false, persistSession: false } }
);

const { data: product, error } = await serviceClient
  .from('products')
  .select('*')
  .eq('id', id)
  .single();

if (error || !product) return Astro.redirect('/admin?error=product-not-found');

const categories = ['vacuum-sealers', 'accessories', 'bundles', 'other'];
---

<StoreLayout title={`Edit ${product.name} — Nutries Admin`}>
  <StoreNav />
  <CartDrawer />

  <main class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-nutries-grey-400 mb-6">
      <a href="/admin" class="hover:text-nutries-indigo-600">Admin</a>
      <span>/</span>
      <a href="/admin" class="hover:text-nutries-indigo-600">Products</a>
      <span>/</span>
      <span class="text-nutries-grey-700 font-medium">Edit</span>
    </nav>

    <div class="flex items-center justify-between mb-8">
      <h1 class="font-display text-3xl font-bold text-nutries-grey-900">Edit Product</h1>
      <a href="/admin" class="text-sm text-nutries-grey-400 hover:text-nutries-indigo-600 font-medium transition-colors">
        &larr; Back to Admin
      </a>
    </div>

    <div id="form-error" class="hidden mb-6 bg-red-50 border border-red-200 text-red-700 text-sm px-4 py-3 rounded-xl"></div>
    <div id="form-success" class="hidden mb-6 bg-green-50 border border-green-200 text-green-700 text-sm px-4 py-3 rounded-xl"></div>

    <form id="product-form" class="space-y-6">

      <!-- Basic info -->
      <div class="bg-white rounded-2xl border border-nutries-grey-100 p-6 space-y-4">
        <h2 class="font-semibold text-nutries-grey-900 mb-2">Basic Information</h2>

        <div>
          <label class="block text-xs font-semibold text-nutries-grey-700 mb-1.5 uppercase tracking-wide">Product Name *</label>
          <input name="name" required type="text" maxlength="200" value={product.name}
            class="w-full px-4 py-3 rounded-xl border border-nutries-grey-200 text-sm focus:outline-none focus:ring-2 focus:ring-nutries-indigo-300 transition"/>
        </div>

        <div>
          <label class="block text-xs font-semibold text-nutries-grey-700 mb-1.5 uppercase tracking-wide">Slug (URL handle) *</label>
          <div class="flex items-center gap-2">
            <span class="text-nutries-grey-400 text-sm">/products/</span>
            <input name="slug" required type="text" pattern="[a-z0-9-]+" value={product.slug}
              class="flex-1 px-4 py-3 rounded-xl border border-nutries-grey-200 text-sm focus:outline-none focus:ring-2 focus:ring-nutries-indigo-300 transition"/>
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-nutries-grey-700 mb-1.5 uppercase tracking-wide">Tagline</label>
          <input name="tagline" type="text" maxlength="200" value={product.tagline || ''}
            class="w-full px-4 py-3 rounded-xl border border-nutries-grey-200 text-sm focus:outline-none focus:ring-2 focus:ring-nutries-indigo-300 transition"
            placeholder="Short punchy subtitle"/>
        </div>

        <div>
          <label class="block text-xs font-semibold text-nutries-grey-700 mb-1.5 uppercase tracking-wide">Description</label>
          <textarea name="description" rows="5"
            class="w-full px-4 py-3 rounded-xl border border-nutries-grey-200 text-sm focus:outline-none focus:ring-2 focus:ring-nutries-indigo-300 transition resize-none">{product.description || ''}</textarea>
        </div>
      </div>

      <!-- Pricing -->
      <div class="bg-white rounded-2xl border border-nutries-grey-100 p-6">
        <h2 class="font-semibold text-nutries-grey-900 mb-4">Pricing & Inventory</h2>
        <div class="grid sm:grid-cols-3 gap-4">
          <div>
            <label class="block text-xs font-semibold text-nutries-grey-700 mb-1.5 uppercase tracking-wide">Price ($) *</label>
            <input name="price" required type="number" step="0.01" min="0" value={product.price}
              class="w-full px-4 py-3 rounded-xl border border-nutries-grey-200 text-sm focus:outline-none focus:ring-2 focus:ring-nutries-indigo-300 transition"/>
          </div>
          <div>
            <label class="block text-xs font-semibold text-nutries-grey-700 mb-1.5 uppercase tracking-wide">Compare-at Price ($)</label>
            <input name="compare_price" type="number" step="0.01" min="0" value={product.compare_price || ''}
              class="w-full px-4 py-3 rounded-xl border border-nutries-grey-200 text-sm focus:outline-none focus:ring-2 focus:ring-nutries-indigo-300 transition"
              placeholder="199.99"/>
          </div>
          <div>
            <label class="block text-xs font-semibold text-nutries-grey-700 mb-1.5 uppercase tracking-wide">Stock Count *</label>
            <input name="stock" required type="number" min="0" value={product.stock}
              class="w-full px-4 py-3 rounded-xl border border-nutries-grey-200 text-sm focus:outline-none focus:ring-2 focus:ring-nutries-indigo-300 transition"/>
          </div>
        </div>
        <div class="mt-4">
          <label class="block text-xs font-semibold text-nutries-grey-700 mb-1.5 uppercase tracking-wide">SKU</label>
          <input name="sku" type="text" value={product.sku || ''}
            class="w-full px-4 py-3 rounded-xl border border-nutries-grey-200 text-sm focus:outline-none focus:ring-2 focus:ring-nutries-indigo-300 transition"/>
        </div>
      </div>

      <!-- Category & flags -->
      <div class="bg-white rounded-2xl border border-nutries-grey-100 p-6">
        <h2 class="font-semibold text-nutries-grey-900 mb-4">Organisation</h2>
        <div class="grid sm:grid-cols-2 gap-4 mb-4">
          <div>
            <label class="block text-xs font-semibold text-nutries-grey-700 mb-1.5 uppercase tracking-wide">Category *</label>
            <select name="category" required
              class="w-full px-4 py-3 rounded-xl border border-nutries-grey-200 text-sm focus:outline-none focus:ring-2 focus:ring-nutries-indigo-300 transition bg-white">
              {categories.map(cat => (
                <option value={cat} selected={product.category === cat}>{cat}</option>
              ))}
            </select>
          </div>
        </div>
        <div class="flex flex-wrap gap-6">
          <label class="flex items-center gap-2 cursor-pointer">
            <input name="is_featured" type="checkbox" checked={product.is_featured}
              class="rounded border-nutries-grey-300 text-nutries-indigo-600 focus:ring-nutries-indigo-300"/>
            <span class="text-sm text-nutries-grey-700 font-medium">Featured product (shown on homepage)</span>
          </label>
          <label class="flex items-center gap-2 cursor-pointer">
            <input name="is_active" type="checkbox" checked={product.is_active}
              class="rounded border-nutries-grey-300 text-nutries-green-600 focus:ring-nutries-green-300"/>
            <span class="text-sm text-nutries-grey-700 font-medium">Active (visible to shoppers)</span>
          </label>
        </div>
      </div>

      <!-- Features -->
      <div class="bg-white rounded-2xl border border-nutries-grey-100 p-6">
        <h2 class="font-semibold text-nutries-grey-900 mb-2">Feature Bullets</h2>
        <p class="text-nutries-grey-400 text-xs mb-4">One feature per line.</p>
        <textarea name="features" rows="6"
          class="w-full px-4 py-3 rounded-xl border border-nutries-grey-200 text-sm focus:outline-none focus:ring-2 focus:ring-nutries-indigo-300 transition resize-none">{(product.features || []).join('\n')}</textarea>
      </div>

      <!-- Images -->
      <div class="bg-white rounded-2xl border border-nutries-grey-100 p-6">
        <h2 class="font-semibold text-nutries-grey-900 mb-2">Product Images</h2>
        <p class="text-nutries-grey-400 text-xs mb-4">Upload new images to replace existing ones, or leave empty to keep current images. Max 10 MB each.</p>

        {product.images && product.images.length > 0 && (
          <div class="flex flex-wrap gap-3 mb-4">
            {product.images.map((img: string, i: number) => (
              <div class="relative w-20 h-20 rounded-xl overflow-hidden border border-nutries-grey-200">
                <img src={img} alt={`Product image ${i + 1}`} class="w-full h-full object-cover"/>
                {i === 0 && (
                  <span class="absolute bottom-0 left-0 right-0 bg-black/50 text-white text-[9px] text-center py-0.5">Main</span>
                )}
              </div>
            ))}
          </div>
        )}

        <div
          id="drop-zone"
          class="border-2 border-dashed border-nutries-grey-200 rounded-xl p-8 text-center cursor-pointer hover:border-nutries-indigo-400 hover:bg-nutries-indigo-50/30 transition-all"
        >
          <svg class="w-10 h-10 text-nutries-grey-300 mx-auto mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          <p class="text-nutries-grey-500 text-sm font-medium mb-1">Drop new images here or click to browse</p>
          <p class="text-nutries-grey-300 text-xs">PNG, JPG, WebP · Max 10 MB each</p>
          <input id="image-input" type="file" accept="image/*" multiple class="hidden"/>
        </div>
        <div id="image-previews" class="flex flex-wrap gap-3 mt-4"></div>
      </div>

      <!-- Submit -->
      <div class="flex gap-4">
        <button
          type="submit"
          id="submit-btn"
          class="flex-1 py-3.5 rounded-2xl bg-btn-indigo text-white font-bold text-base hover:shadow-glow-i transition-all hover:-translate-y-0.5"
        >
          Save Changes
        </button>
        <a href="/admin" class="px-6 py-3.5 rounded-2xl border border-nutries-grey-200 text-nutries-grey-600 font-semibold text-base hover:bg-nutries-grey-50 transition-colors text-center">
          Cancel
        </a>
      </div>
    </form>

    <!-- Danger zone -->
    <div class="mt-10 bg-white rounded-2xl border border-red-200 p-6">
      <h2 class="font-semibold text-red-700 mb-2">Danger Zone</h2>
      <p class="text-nutries-grey-400 text-sm mb-4">Permanently delete this product. This cannot be undone.</p>
      <button id="delete-btn" type="button"
        class="px-5 py-2.5 rounded-xl border border-red-300 text-red-600 text-sm font-semibold hover:bg-red-50 transition-colors">
        Delete Product
      </button>
    </div>

  </main>
  <StoreFooter />
</StoreLayout>

<script is:inline>
(function () {
  var productId = window.location.pathname.split('/')[3];

  var dropZone  = document.getElementById('drop-zone');
  var fileInput = document.getElementById('image-input');
  var previews  = document.getElementById('image-previews');

  var stagedFiles = [];

  if (dropZone) {
    dropZone.addEventListener('click', function () { if (fileInput) fileInput.click(); });
    dropZone.addEventListener('dragover', function (e) {
      e.preventDefault();
      dropZone.classList.add('border-nutries-indigo-400');
    });
    dropZone.addEventListener('dragleave', function () {
      dropZone.classList.remove('border-nutries-indigo-400');
    });
    dropZone.addEventListener('drop', function (e) {
      e.preventDefault();
      dropZone.classList.remove('border-nutries-indigo-400');
      stageFiles(Array.from(e.dataTransfer ? e.dataTransfer.files : []));
    });
  }

  if (fileInput) {
    fileInput.addEventListener('change', function () {
      stageFiles(Array.from(fileInput.files || []));
    });
  }

  function stageFiles(files) {
    stagedFiles = files.slice(0, 5);
    showPreviews(stagedFiles);
  }

  function showPreviews(files) {
    if (!previews) return;
    previews.innerHTML = '';
    files.forEach(function (file, idx) {
      var reader = new FileReader();
      reader.onload = function () {
        var div = document.createElement('div');
        div.id = 'preview-' + idx;
        div.className = 'relative w-20 h-20 rounded-xl overflow-hidden border border-nutries-grey-200';
        div.innerHTML =
          '<img src="' + reader.result + '" class="w-full h-full object-cover"/>' +
          '<div class="check-overlay absolute inset-0 bg-green-500/80 flex items-center justify-center opacity-0 transition-opacity">' +
            '<svg class="w-8 h-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">' +
              '<path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>' +
            '</svg>' +
          '</div>';
        previews.appendChild(div);
      };
      reader.readAsDataURL(file);
    });
  }

  function markUploaded(idx) {
    var div = document.getElementById('preview-' + idx);
    var overlay = div && div.querySelector('.check-overlay');
    if (overlay) overlay.style.opacity = '1';
  }

  function uploadImages(files, btn) {
    var urls = [];
    var i = 0;
    function next() {
      if (i >= files.length) return Promise.resolve(urls);
      btn.textContent = 'Uploading image ' + (i + 1) + ' of ' + files.length + '…';
      var fd = new FormData();
      fd.append('file', files[i]);
      var idx = i;
      i++;
      return fetch('/api/admin/upload-image', { method: 'POST', body: fd })
        .then(function (res) { return res.json().then(function (data) { return { ok: res.ok, data: data }; }); })
        .then(function (r) {
          if (!r.ok || r.data.error) throw new Error(r.data.error || 'Image upload failed');
          urls.push(r.data.url);
          markUploaded(idx);
          return next();
        });
    }
    return next();
  }

  // Form submit
  var productForm = document.getElementById('product-form');
  if (productForm) {
    productForm.addEventListener('submit', function (e) {
      e.preventDefault();
      var form    = e.target;
      var btn     = document.getElementById('submit-btn');
      var errorEl = document.getElementById('form-error');
      var succEl  = document.getElementById('form-success');

      btn.disabled    = true;
      btn.textContent = 'Saving…';
      errorEl.classList.add('hidden');
      succEl.classList.add('hidden');

      uploadImages(stagedFiles, btn)
        .then(function (newImageUrls) {
          btn.textContent = 'Saving changes…';
          var data = new FormData(form);
          var body = {
            name:          data.get('name'),
            slug:          data.get('slug'),
            tagline:       data.get('tagline')       || '',
            description:   data.get('description')   || '',
            price:         parseFloat(data.get('price')),
            compare_price: data.get('compare_price') ? parseFloat(data.get('compare_price')) : null,
            stock:         parseInt(data.get('stock'), 10),
            sku:           data.get('sku')           || null,
            category:      data.get('category'),
            is_featured:   data.has('is_featured'),
            is_active:     data.has('is_active'),
            features:      (data.get('features') || '').split('\n').map(function (f) { return f.trim(); }).filter(Boolean),
          };
          if (newImageUrls.length > 0) {
            body.images = newImageUrls;
          }
          return fetch('/api/products/' + productId, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body),
          }).then(function (res) { return res.json().then(function (json) { return { ok: res.ok, json: json }; }); });
        })
        .then(function (r) {
          if (!r.ok || r.json.error) throw new Error(r.json.error || 'Failed to save changes');
          succEl.textContent = 'Changes saved!';
          succEl.classList.remove('hidden');
          btn.disabled    = false;
          btn.textContent = 'Save Changes';
        })
        .catch(function (err) {
          errorEl.textContent = err.message;
          errorEl.classList.remove('hidden');
          btn.disabled    = false;
          btn.textContent = 'Save Changes';
        });
    });
  }

  // Delete
  var deleteBtn = document.getElementById('delete-btn');
  if (deleteBtn) {
    deleteBtn.addEventListener('click', function () {
      if (!confirm('Delete this product? This cannot be undone.')) return;
      deleteBtn.disabled    = true;
      deleteBtn.textContent = 'Deleting…';
      fetch('/api/products/' + productId, { method: 'DELETE' })
        .then(function (res) { return res.json().then(function (json) { return { ok: res.ok, json: json }; }); })
        .then(function (r) {
          if (!r.ok || r.json.error) throw new Error(r.json.error || 'Failed to delete product');
          window.location.href = '/admin';
        })
        .catch(function (err) {
          var errorEl = document.getElementById('form-error');
          errorEl.textContent = err.message;
          errorEl.classList.remove('hidden');
          deleteBtn.disabled    = false;
          deleteBtn.textContent = 'Delete Product';
        });
    });
  }
})();
</script>
