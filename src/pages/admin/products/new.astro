---
import StoreLayout from '../../../layouts/StoreLayout.astro';
import StoreNav    from '../../../components/store/StoreNav.astro';
import CartDrawer  from '../../../components/store/CartDrawer.astro';
import StoreFooter from '../../../components/store/StoreFooter.astro';
import { getSessionFromCookies, isAdmin } from '../../../lib/supabase';

const { user } = await getSessionFromCookies(Astro.cookies);
if (!user || !isAdmin(user.email)) return Astro.redirect('/login');
---

<StoreLayout title="Add Product — Nutries Admin">
  <StoreNav />
  <CartDrawer />

  <main class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-nutries-grey-400 mb-6">
      <a href="/admin" class="hover:text-nutries-indigo-600">Admin</a>
      <span>/</span>
      <span class="text-nutries-grey-700 font-medium">Add Product</span>
    </nav>

    <h1 class="font-display text-3xl font-bold text-nutries-grey-900 mb-8">Add New Product</h1>

    <div id="form-error" class="hidden mb-6 bg-nutries-red-50 border border-nutries-red-200 text-nutries-red-700 text-sm px-4 py-3 rounded-xl"></div>
    <div id="form-success" class="hidden mb-6 bg-nutries-green-50 border border-nutries-green-200 text-nutries-green-700 text-sm px-4 py-3 rounded-xl"></div>

    <form id="product-form" class="space-y-6">
      <!-- Basic info -->
      <div class="bg-white rounded-2xl border border-nutries-grey-100 p-6 space-y-4">
        <h2 class="font-semibold text-nutries-grey-900 mb-2">Basic Information</h2>

        <div>
          <label class="block text-xs font-semibold text-nutries-grey-700 mb-1.5 uppercase tracking-wide">Product Name *</label>
          <input name="name" required type="text" maxlength="200"
            class="w-full px-4 py-3 rounded-xl border border-nutries-grey-200 text-sm focus:outline-none focus:ring-2 focus:ring-nutries-indigo-300 transition"
            placeholder="e.g., Chef Preserve Compact Vacuum Sealer"/>
        </div>

        <div>
          <label class="block text-xs font-semibold text-nutries-grey-700 mb-1.5 uppercase tracking-wide">Slug (URL handle) *</label>
          <div class="flex items-center gap-2">
            <span class="text-nutries-grey-400 text-sm">/products/</span>
            <input name="slug" required type="text" pattern="[a-z0-9-]+"
              class="flex-1 px-4 py-3 rounded-xl border border-nutries-grey-200 text-sm focus:outline-none focus:ring-2 focus:ring-nutries-indigo-300 transition"
              placeholder="chef-preserve-compact"/>
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-nutries-grey-700 mb-1.5 uppercase tracking-wide">Tagline</label>
          <input name="tagline" type="text" maxlength="200"
            class="w-full px-4 py-3 rounded-xl border border-nutries-grey-200 text-sm focus:outline-none focus:ring-2 focus:ring-nutries-indigo-300 transition"
            placeholder="Short punchy subtitle shown under the product name"/>
        </div>

        <div>
          <label class="block text-xs font-semibold text-nutries-grey-700 mb-1.5 uppercase tracking-wide">Description</label>
          <textarea name="description" rows="5"
            class="w-full px-4 py-3 rounded-xl border border-nutries-grey-200 text-sm focus:outline-none focus:ring-2 focus:ring-nutries-indigo-300 transition resize-none"
            placeholder="Full product description (markdown not supported)..."></textarea>
        </div>
      </div>

      <!-- Pricing -->
      <div class="bg-white rounded-2xl border border-nutries-grey-100 p-6">
        <h2 class="font-semibold text-nutries-grey-900 mb-4">Pricing & Inventory</h2>
        <div class="grid sm:grid-cols-3 gap-4">
          <div>
            <label class="block text-xs font-semibold text-nutries-grey-700 mb-1.5 uppercase tracking-wide">Price ($) *</label>
            <input name="price" required type="number" step="0.01" min="0"
              class="w-full px-4 py-3 rounded-xl border border-nutries-grey-200 text-sm focus:outline-none focus:ring-2 focus:ring-nutries-indigo-300 transition"
              placeholder="149.99"/>
          </div>
          <div>
            <label class="block text-xs font-semibold text-nutries-grey-700 mb-1.5 uppercase tracking-wide">Compare-at Price ($)</label>
            <input name="compare_price" type="number" step="0.01" min="0"
              class="w-full px-4 py-3 rounded-xl border border-nutries-grey-200 text-sm focus:outline-none focus:ring-2 focus:ring-nutries-indigo-300 transition"
              placeholder="199.99"/>
          </div>
          <div>
            <label class="block text-xs font-semibold text-nutries-grey-700 mb-1.5 uppercase tracking-wide">Stock Count *</label>
            <input name="stock" required type="number" min="0"
              class="w-full px-4 py-3 rounded-xl border border-nutries-grey-200 text-sm focus:outline-none focus:ring-2 focus:ring-nutries-indigo-300 transition"
              placeholder="50"/>
          </div>
        </div>
        <div class="mt-4">
          <label class="block text-xs font-semibold text-nutries-grey-700 mb-1.5 uppercase tracking-wide">SKU</label>
          <input name="sku" type="text"
            class="w-full px-4 py-3 rounded-xl border border-nutries-grey-200 text-sm focus:outline-none focus:ring-2 focus:ring-nutries-indigo-300 transition"
            placeholder="CP-VS-001"/>
        </div>
      </div>

      <!-- Category & flags -->
      <div class="bg-white rounded-2xl border border-nutries-grey-100 p-6">
        <h2 class="font-semibold text-nutries-grey-900 mb-4">Organisation</h2>
        <div class="grid sm:grid-cols-2 gap-4 mb-4">
          <div>
            <label class="block text-xs font-semibold text-nutries-grey-700 mb-1.5 uppercase tracking-wide">Category *</label>
            <select name="category" required
              class="w-full px-4 py-3 rounded-xl border border-nutries-grey-200 text-sm focus:outline-none focus:ring-2 focus:ring-nutries-indigo-300 transition bg-white">
              <option value="vacuum-sealers">Vacuum Sealers</option>
              <option value="accessories">Bags & Accessories</option>
              <option value="bundles">Bundles & Kits</option>
              <option value="other">Other</option>
            </select>
          </div>
        </div>
        <div class="flex flex-wrap gap-6">
          <label class="flex items-center gap-2 cursor-pointer">
            <input name="is_featured" type="checkbox" class="rounded border-nutries-grey-300 text-nutries-indigo-600 focus:ring-nutries-indigo-300"/>
            <span class="text-sm text-nutries-grey-700 font-medium">Featured product (shown on homepage)</span>
          </label>
          <label class="flex items-center gap-2 cursor-pointer">
            <input name="is_active" type="checkbox" checked class="rounded border-nutries-grey-300 text-nutries-green-600 focus:ring-nutries-green-300"/>
            <span class="text-sm text-nutries-grey-700 font-medium">Active (visible to shoppers)</span>
          </label>
        </div>
      </div>

      <!-- Features -->
      <div class="bg-white rounded-2xl border border-nutries-grey-100 p-6">
        <h2 class="font-semibold text-nutries-grey-900 mb-2">Feature Bullets</h2>
        <p class="text-nutries-grey-400 text-xs mb-4">One feature per line — shown as bullet points on the product page.</p>
        <textarea name="features" rows="6"
          class="w-full px-4 py-3 rounded-xl border border-nutries-grey-200 text-sm focus:outline-none focus:ring-2 focus:ring-nutries-indigo-300 transition resize-none"
          placeholder="One-touch automatic operation&#10;Dual-pump motor removes 99% of air&#10;Compatible with all standard bags"></textarea>
      </div>

      <!-- Image upload -->
      <div class="bg-white rounded-2xl border border-nutries-grey-100 p-6">
        <h2 class="font-semibold text-nutries-grey-900 mb-2">Product Images</h2>
        <p class="text-nutries-grey-400 text-xs mb-4">Upload up to 5 images. First image is the main display image. Max 10 MB each.</p>
        <div
          id="drop-zone"
          class="border-2 border-dashed border-nutries-grey-200 rounded-xl p-8 text-center cursor-pointer hover:border-nutries-indigo-400 hover:bg-nutries-indigo-50/30 transition-all"
        >
          <svg class="w-10 h-10 text-nutries-grey-300 mx-auto mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          <p class="text-nutries-grey-500 text-sm font-medium mb-1">Drop images here or click to browse</p>
          <p class="text-nutries-grey-300 text-xs">PNG, JPG, WebP · Max 10 MB each</p>
          <input id="image-input" name="images" type="file" accept="image/*" multiple class="hidden"/>
        </div>
        <div id="image-previews" class="flex flex-wrap gap-3 mt-4"></div>
      </div>

      <!-- Submit -->
      <div class="flex gap-4">
        <button
          type="submit"
          id="submit-btn"
          class="flex-1 py-3.5 rounded-2xl bg-btn-red text-white font-bold text-base hover:shadow-glow-r transition-all hover:-translate-y-0.5"
        >
          Save Product
        </button>
        <a href="/admin" class="px-6 py-3.5 rounded-2xl border border-nutries-grey-200 text-nutries-grey-600 font-semibold text-base hover:bg-nutries-grey-50 transition-colors text-center">
          Cancel
        </a>
      </div>
    </form>
  </main>

  <StoreFooter />
</StoreLayout>

<script>
  // Drop zone
  const dropZone   = document.getElementById('drop-zone');
  const fileInput  = document.getElementById('image-input') as HTMLInputElement | null;
  const previews   = document.getElementById('image-previews');

  dropZone?.addEventListener('click', () => fileInput?.click());
  dropZone?.addEventListener('dragover', e => { e.preventDefault(); dropZone.classList.add('border-nutries-indigo-400'); });
  dropZone?.addEventListener('dragleave', () => dropZone.classList.remove('border-nutries-indigo-400'));
  dropZone?.addEventListener('drop', e => {
    e.preventDefault();
    dropZone.classList.remove('border-nutries-indigo-400');
    showPreviews(Array.from(e.dataTransfer?.files || []));
  });
  fileInput?.addEventListener('change', () => showPreviews(Array.from(fileInput.files || [])));

  function showPreviews(files: File[]) {
    if (!previews) return;
    previews.innerHTML = '';
    files.slice(0, 5).forEach(file => {
      const reader = new FileReader();
      reader.onload = () => {
        const div = document.createElement('div');
        div.className = 'relative w-20 h-20 rounded-xl overflow-hidden border border-nutries-grey-200';
        div.innerHTML = `<img src="${reader.result}" class="w-full h-full object-cover"/>`;
        previews.appendChild(div);
      };
      reader.readAsDataURL(file);
    });
  }

  // Auto-generate slug from name
  const nameInput = document.querySelector('[name="name"]') as HTMLInputElement | null;
  const slugInput = document.querySelector('[name="slug"]') as HTMLInputElement | null;
  nameInput?.addEventListener('input', () => {
    if (!slugInput || slugInput.value) return;
    slugInput.value = nameInput.value
      .toLowerCase()
      .replace(/[^a-z0-9\s-]/g, '')
      .replace(/\s+/g, '-')
      .replace(/-+/g, '-')
      .slice(0, 60);
  });

  // Form submit
  document.getElementById('product-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form    = e.target as HTMLFormElement;
    const btn     = document.getElementById('submit-btn') as HTMLButtonElement;
    const errorEl = document.getElementById('form-error');
    const succEl  = document.getElementById('form-success');

    btn.disabled = true;
    btn.textContent = 'Saving…';
    errorEl?.classList.add('hidden');

    try {
      const data = new FormData(form);

      const body = {
        name:          data.get('name'),
        slug:          data.get('slug'),
        tagline:       data.get('tagline') || '',
        description:   data.get('description') || '',
        price:         parseFloat(data.get('price') as string),
        compare_price: data.get('compare_price') ? parseFloat(data.get('compare_price') as string) : null,
        stock:         parseInt(data.get('stock') as string, 10),
        sku:           data.get('sku') || null,
        category:      data.get('category'),
        is_featured:   data.has('is_featured'),
        is_active:     data.has('is_active'),
        features:      (data.get('features') as string || '').split('\n').map(f => f.trim()).filter(Boolean),
      };

      const res  = await fetch('/api/products', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
      const json = await res.json();

      if (!res.ok || json.error) throw new Error(json.error || 'Failed to save product');

      succEl!.textContent = `✓ Product "${json.name}" saved! Redirecting…`;
      succEl?.classList.remove('hidden');
      setTimeout(() => window.location.href = '/admin', 1500);
    } catch (err: any) {
      errorEl!.textContent = err.message;
      errorEl?.classList.remove('hidden');
      btn.disabled = false;
      btn.textContent = 'Save Product';
    }
  });
</script>
