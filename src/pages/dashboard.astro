---
import Layout from '../layouts/Layout.astro';
import { getSessionFromCookies, isAdmin } from '../lib/supabase';

const { user, client } = await getSessionFromCookies(Astro.cookies);
if (!user) return Astro.redirect('/login');

const admin = isAdmin(user.email);

// Fetch all videos (admins see all; regular users see all too for an LMS)
const { data: videos, error: videosError } = await client
  .from('videos')
  .select('*')
  .order('created_at', { ascending: false });
---

<Layout title="Dashboard â€” AkinsMedia">
  <div class="min-h-screen bg-slate-50 flex flex-col">

    <!-- Dashboard nav -->
    <header class="sticky top-0 z-50 bg-white border-b border-slate-200 h-14 flex items-center justify-between px-4 sm:px-6 lg:px-8">
      <a href="/" class="inline-flex items-center gap-2">
        <div class="w-7 h-7 bg-brand-900 rounded-lg flex items-center justify-center">
          <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 14.25h13.5m-13.5 0a3 3 0 01-3-3m3 3a3 3 0 100 6h13.5a3 3 0 100-6m-16.5-3a3 3 0 013-3h13.5a3 3 0 013 3m-19.5 0a4.5 4.5 0 01.9-2.7L5.737 5.1a3.375 3.375 0 012.7-1.35h7.126c1.062 0 2.062.5 2.7 1.35l2.587 3.45a4.5 4.5 0 01.9 2.7m0 0a3 3 0 01-3 3m0 3h.008v.008h-.008v-.008zm0-6h.008v.008h-.008v-.008zm-3 6h.008v.008h-.008v-.008zm0-6h.008v.008h-.008v-.008z" />
          </svg>
        </div>
        <span class="font-bold text-brand-900 text-sm">AkinsMedia</span>
      </a>

      <div class="flex items-center gap-3">
        <span class="hidden sm:block text-sm text-slate-500">{user.email}</span>
        {admin && (
          <span class="px-2 py-0.5 bg-amber-100 text-amber-800 text-xs font-semibold rounded-full">Admin</span>
        )}
        <form action="/api/auth/logout" method="POST">
          <button type="submit" class="text-sm text-slate-600 hover:text-red-600 transition-colors font-medium">
            Log out
          </button>
        </form>
      </div>
    </header>

    <!-- Main content -->
    <main class="flex-1 max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-8">

      <!-- Admin: Upload section -->
      {admin && (
        <section class="mb-10">
          <div class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8">
            <div class="flex items-center gap-3 mb-6">
              <div class="w-9 h-9 bg-brand-100 rounded-lg flex items-center justify-center">
                <svg class="w-5 h-5 text-brand-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                </svg>
              </div>
              <div>
                <h2 class="font-bold text-slate-900">Upload Training Video</h2>
                <p class="text-xs text-slate-500">Supports MP4, MOV, WebM â€” max 500 MB per upload</p>
              </div>
            </div>

            <form id="upload-form" class="space-y-4">
              <div class="grid sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-sm font-medium text-slate-700 mb-1" for="title">Video Title</label>
                  <input id="title" name="title" type="text" required placeholder="Oracle 23AI â€“ AI Vector Search"
                    class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-500" />
                </div>
                <div>
                  <label class="block text-sm font-medium text-slate-700 mb-1" for="description">Description (optional)</label>
                  <input id="description" name="description" type="text" placeholder="Brief summaryâ€¦"
                    class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-500" />
                </div>
              </div>

              <!-- File picker -->
              <div id="file-drop"
                class="border-2 border-dashed border-slate-300 rounded-xl p-8 text-center cursor-pointer hover:border-brand-400 hover:bg-brand-50 transition-colors">
                <svg class="w-10 h-10 text-slate-400 mx-auto mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5l4.72-4.72a.75.75 0 011.28.53v11.38a.75.75 0 01-1.28.53l-4.72-4.72M4.5 18.75h9a2.25 2.25 0 002.25-2.25v-9a2.25 2.25 0 00-2.25-2.25h-9A2.25 2.25 0 002.25 7.5v9a2.25 2.25 0 002.25 2.25z" />
                </svg>
                <p class="text-sm font-medium text-slate-700" id="file-label">Drop video file here, or <span class="text-brand-600 underline">browse</span></p>
                <p class="text-xs text-slate-400 mt-1">MP4, MOV, WebM â€” up to 500 MB</p>
                <input id="video-file" name="video" type="file" accept="video/*" required class="hidden" />
              </div>

              <!-- Progress bar -->
              <div id="progress-wrap" class="hidden">
                <div class="flex justify-between text-xs text-slate-500 mb-1">
                  <span id="progress-label">Uploadingâ€¦</span>
                  <span id="progress-pct">0%</span>
                </div>
                <div class="w-full bg-slate-200 rounded-full h-2">
                  <div id="progress-bar" class="bg-brand-600 h-2 rounded-full transition-all duration-300" style="width:0%"></div>
                </div>
              </div>

              <button type="submit" id="upload-btn"
                class="px-6 py-2.5 bg-brand-700 text-white text-sm font-semibold rounded-xl hover:bg-brand-800 transition-colors shadow-sm disabled:opacity-50">
                Upload Video
              </button>

              <div id="upload-success" class="hidden p-3 bg-emerald-50 border border-emerald-200 rounded-lg text-sm text-emerald-800"></div>
              <div id="upload-error"   class="hidden p-3 bg-red-50 border border-red-200 rounded-lg text-sm text-red-700"></div>
            </form>
          </div>
        </section>
      )}

      <!-- Training Library -->
      <section>
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-xl font-bold text-slate-900">Training Library</h2>
          <span class="text-sm text-slate-500">{videos?.length ?? 0} video{videos?.length !== 1 ? 's' : ''}</span>
        </div>

        {(!videos || videos.length === 0) ? (
          <div class="bg-white rounded-2xl border border-slate-200 p-12 text-center">
            <svg class="w-12 h-12 text-slate-300 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5l4.72-4.72a.75.75 0 011.28.53v11.38a.75.75 0 01-1.28.53l-4.72-4.72M4.5 18.75h9a2.25 2.25 0 002.25-2.25v-9a2.25 2.25 0 00-2.25-2.25h-9A2.25 2.25 0 002.25 7.5v9a2.25 2.25 0 002.25 2.25z" />
            </svg>
            <p class="text-slate-500 text-sm">No trainings uploaded yet.</p>
            {admin && <p class="text-slate-400 text-xs mt-1">Upload your first video above.</p>}
          </div>
        ) : (
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5" id="video-grid">
            {videos.map((video: any) => (
              <button
                class="video-card text-left bg-white rounded-2xl border border-slate-200 overflow-hidden hover:shadow-md hover:border-brand-300 transition-all duration-200 group"
                data-url={video.url}
                data-title={video.title}
                data-description={video.description ?? ''}
              >
                <!-- Thumbnail -->
                <div class="aspect-video bg-brand-900 relative flex items-center justify-center">
                  <div class="absolute inset-0 bg-gradient-to-br from-brand-800 to-brand-900 opacity-80"></div>
                  <div class="relative w-14 h-14 bg-white/10 rounded-full flex items-center justify-center border-2 border-white/30 group-hover:bg-white/20 transition-colors">
                    <svg class="w-6 h-6 text-white ml-1" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M6.3 2.841A1.5 1.5 0 004 4.11V15.89a1.5 1.5 0 002.3 1.269l9.344-5.89a1.5 1.5 0 000-2.538L6.3 2.84z"/>
                    </svg>
                  </div>
                </div>
                <!-- Info -->
                <div class="p-4">
                  <h3 class="font-semibold text-slate-900 text-sm line-clamp-2 group-hover:text-brand-700 transition-colors">{video.title}</h3>
                  {video.description && (
                    <p class="text-xs text-slate-500 mt-1 line-clamp-2">{video.description}</p>
                  )}
                  <p class="text-xs text-slate-400 mt-2">
                    {new Date(video.created_at).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                  </p>
                </div>
              </button>
            ))}
          </div>
        )}
      </section>

    </main>

  </div>

  <!-- Video Player Modal -->
  <div id="player-modal" class="fixed inset-0 z-50 hidden bg-black/80 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="w-full max-w-4xl bg-slate-900 rounded-2xl overflow-hidden shadow-2xl">

      <!-- Modal header -->
      <div class="flex items-center justify-between px-5 py-3 border-b border-slate-700">
        <div>
          <p id="modal-title" class="font-semibold text-white text-sm"></p>
          <p id="modal-desc"  class="text-xs text-slate-400 mt-0.5"></p>
        </div>
        <button id="close-modal" class="text-slate-400 hover:text-white transition-colors p-1">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Video element -->
      <div class="relative bg-black">
        <video id="modal-video" class="w-full aspect-video" preload="metadata">
          <source id="modal-video-src" src="" type="video/mp4" />
          Your browser does not support HTML5 video.
        </video>
      </div>

      <!-- Custom controls -->
      <div id="video-controls" class="px-5 py-4 space-y-3">
        <!-- Progress bar -->
        <div class="flex items-center gap-3">
          <span id="current-time" class="text-xs font-mono text-slate-400 w-10 text-right">0:00</span>
          <div id="progress-track" class="flex-1 h-1.5 bg-slate-700 rounded-full cursor-pointer relative group">
            <div id="progress-fill" class="h-full bg-brand-500 rounded-full transition-all pointer-events-none" style="width:0%"></div>
            <div id="progress-thumb" class="absolute top-1/2 -translate-y-1/2 w-3 h-3 bg-white rounded-full shadow opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none" style="left:0%"></div>
          </div>
          <span id="duration" class="text-xs font-mono text-slate-400 w-10">0:00</span>
        </div>

        <!-- Buttons row -->
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <!-- Play/Pause -->
            <button id="play-btn" class="text-white hover:text-brand-400 transition-colors">
              <svg id="play-icon"  class="w-7 h-7" fill="currentColor" viewBox="0 0 20 20"><path d="M6.3 2.841A1.5 1.5 0 004 4.11V15.89a1.5 1.5 0 002.3 1.269l9.344-5.89a1.5 1.5 0 000-2.538L6.3 2.84z"/></svg>
              <svg id="pause-icon" class="w-7 h-7 hidden" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zM7 8a1 1 0 012 0v4a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v4a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
            </button>

            <!-- Skip back 10s -->
            <button id="skip-back" class="text-slate-400 hover:text-white transition-colors" title="Back 10s">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 15L3 9m0 0l6-6M3 9h12a6 6 0 010 12h-3" />
              </svg>
            </button>

            <!-- Skip forward 10s -->
            <button id="skip-fwd" class="text-slate-400 hover:text-white transition-colors" title="Forward 10s">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 15l6-6m0 0l-6-6m6 6H9a6 6 0 000 12h3" />
              </svg>
            </button>

            <!-- Volume -->
            <div class="flex items-center gap-2">
              <button id="mute-btn" class="text-slate-400 hover:text-white transition-colors">
                <svg id="vol-icon" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.114 5.636a9 9 0 010 12.728M16.463 8.288a5.25 5.25 0 010 7.424M6.75 8.25l4.72-4.72a.75.75 0 011.28.53v15.88a.75.75 0 01-1.28.53l-4.72-4.72H4.51c-.88 0-1.704-.507-1.938-1.354A9.01 9.01 0 012.25 12c0-.83.112-1.633.322-2.396C2.806 8.756 3.63 8.25 4.51 8.25H6.75z" />
                </svg>
                <svg id="mute-icon" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 9.75L19.5 12m0 0l2.25 2.25M19.5 12l2.25-2.25M19.5 12l-2.25 2.25m-10.5-6l4.72-4.72a.75.75 0 011.28.53v15.88a.75.75 0 01-1.28.53l-4.72-4.72H4.51c-.88 0-1.704-.507-1.938-1.354A9.01 9.01 0 012.25 12c0-.83.112-1.633.322-2.396C2.806 8.756 3.63 8.25 4.51 8.25H6.75z" />
                </svg>
              </button>
              <input id="volume-slider" type="range" min="0" max="1" step="0.05" value="1"
                class="w-20 accent-brand-500 cursor-pointer" />
            </div>
          </div>

          <!-- Right: speed + fullscreen -->
          <div class="flex items-center gap-3">
            <select id="speed-select" class="bg-slate-800 text-white text-xs rounded px-2 py-1 border border-slate-700 cursor-pointer">
              <option value="0.5">0.5Ã—</option>
              <option value="0.75">0.75Ã—</option>
              <option value="1" selected>1Ã—</option>
              <option value="1.25">1.25Ã—</option>
              <option value="1.5">1.5Ã—</option>
              <option value="2">2Ã—</option>
            </select>
            <button id="fullscreen-btn" class="text-slate-400 hover:text-white transition-colors" title="Fullscreen">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15" />
              </svg>
            </button>
          </div>
        </div>
      </div>

    </div>
  </div>
</Layout>

<script>
// â”€â”€â”€ Upload form â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
const uploadForm  = document.getElementById('upload-form')  as HTMLFormElement | null;
const fileDrop    = document.getElementById('file-drop')    as HTMLDivElement  | null;
const fileInput   = document.getElementById('video-file')   as HTMLInputElement | null;
const fileLabel   = document.getElementById('file-label')   as HTMLParagraphElement | null;
const progressWrap = document.getElementById('progress-wrap') as HTMLDivElement | null;
const progressBar  = document.getElementById('progress-bar')  as HTMLDivElement | null;
const progressPct  = document.getElementById('progress-pct')  as HTMLSpanElement | null;
const progressLbl  = document.getElementById('progress-label') as HTMLSpanElement | null;
const uploadBtn   = document.getElementById('upload-btn')   as HTMLButtonElement | null;
const successBox  = document.getElementById('upload-success') as HTMLDivElement | null;
const errorBox    = document.getElementById('upload-error')   as HTMLDivElement | null;

fileDrop?.addEventListener('click', () => fileInput?.click());
fileDrop?.addEventListener('dragover', (e) => { e.preventDefault(); fileDrop.classList.add('border-brand-500', 'bg-brand-50'); });
fileDrop?.addEventListener('dragleave', () => { fileDrop.classList.remove('border-brand-500', 'bg-brand-50'); });
fileDrop?.addEventListener('drop', (e) => {
  e.preventDefault();
  fileDrop.classList.remove('border-brand-500', 'bg-brand-50');
  const file = e.dataTransfer?.files[0];
  if (file && fileInput) {
    const dt = new DataTransfer();
    dt.items.add(file);
    fileInput.files = dt.files;
    if (fileLabel) fileLabel.textContent = file.name;
  }
});
fileInput?.addEventListener('change', () => {
  const file = fileInput.files?.[0];
  if (file && fileLabel) fileLabel.textContent = file.name;
});

uploadForm?.addEventListener('submit', async (e) => {
  e.preventDefault();
  if (!fileInput?.files?.[0]) return;

  if (successBox) successBox.classList.add('hidden');
  if (errorBox)   errorBox.classList.add('hidden');
  if (uploadBtn)  { uploadBtn.disabled = true; uploadBtn.textContent = 'Uploadingâ€¦'; }
  if (progressWrap) progressWrap.classList.remove('hidden');

  const formData = new FormData(uploadForm);

  const xhr = new XMLHttpRequest();
  xhr.open('POST', '/api/videos/upload');

  xhr.upload.addEventListener('progress', (ev) => {
    if (ev.lengthComputable) {
      const pct = Math.round((ev.loaded / ev.total) * 100);
      if (progressBar) progressBar.style.width = pct + '%';
      if (progressPct) progressPct.textContent = pct + '%';
    }
  });

  xhr.addEventListener('load', () => {
    if (uploadBtn)    { uploadBtn.disabled = false; uploadBtn.textContent = 'Upload Video'; }
    if (progressWrap) progressWrap.classList.add('hidden');
    if (progressBar)  progressBar.style.width = '0%';

    let data: any = {};
    try { data = JSON.parse(xhr.responseText); } catch {}

    if (xhr.status === 200 && data.success) {
      if (successBox) {
        successBox.textContent = `"${data.video.title}" uploaded successfully!`;
        successBox.classList.remove('hidden');
      }
      uploadForm.reset();
      if (fileLabel) fileLabel.innerHTML = 'Drop video file here, or <span class="text-brand-600 underline">browse</span>';
      // Reload to show the new video card
      setTimeout(() => window.location.reload(), 1500);
    } else {
      if (errorBox) {
        errorBox.textContent = data.error ?? 'Upload failed. Please try again.';
        errorBox.classList.remove('hidden');
      }
    }
  });

  xhr.addEventListener('error', () => {
    if (uploadBtn)    { uploadBtn.disabled = false; uploadBtn.textContent = 'Upload Video'; }
    if (progressWrap) progressWrap.classList.add('hidden');
    if (errorBox)     { errorBox.textContent = 'Network error. Please try again.'; errorBox.classList.remove('hidden'); }
  });

  xhr.send(formData);
});

// â”€â”€â”€ Video player modal â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
const modal      = document.getElementById('player-modal')  as HTMLDivElement;
const modalTitle = document.getElementById('modal-title')   as HTMLParagraphElement;
const modalDesc  = document.getElementById('modal-desc')    as HTMLParagraphElement;
const modalVideo = document.getElementById('modal-video')   as HTMLVideoElement;
const modalSrc   = document.getElementById('modal-video-src') as HTMLSourceElement;
const closeModal = document.getElementById('close-modal')   as HTMLButtonElement;

const playBtn    = document.getElementById('play-btn')      as HTMLButtonElement;
const playIcon   = document.getElementById('play-icon')     as SVGElement;
const pauseIcon  = document.getElementById('pause-icon')    as SVGElement;
const skipBack   = document.getElementById('skip-back')     as HTMLButtonElement;
const skipFwd    = document.getElementById('skip-fwd')      as HTMLButtonElement;
const muteBtn    = document.getElementById('mute-btn')      as HTMLButtonElement;
const volIcon    = document.getElementById('vol-icon')      as SVGElement;
const muteIcon   = document.getElementById('mute-icon')     as SVGElement;
const volSlider  = document.getElementById('volume-slider') as HTMLInputElement;
const speedSel   = document.getElementById('speed-select')  as HTMLSelectElement;
const fsBtn      = document.getElementById('fullscreen-btn') as HTMLButtonElement;
const progTrack  = document.getElementById('progress-track') as HTMLDivElement;
const progFill   = document.getElementById('progress-fill') as HTMLDivElement;
const progThumb  = document.getElementById('progress-thumb') as HTMLDivElement;
const curTime    = document.getElementById('current-time')  as HTMLSpanElement;
const durEl      = document.getElementById('duration')      as HTMLSpanElement;

function fmtTime(s: number) {
  const m = Math.floor(s / 60);
  const sec = Math.floor(s % 60);
  return `${m}:${sec.toString().padStart(2, '0')}`;
}

document.querySelectorAll<HTMLButtonElement>('.video-card').forEach(card => {
  card.addEventListener('click', () => {
    const url   = card.dataset.url   ?? '';
    const title = card.dataset.title ?? '';
    const desc  = card.dataset.description ?? '';

    modalTitle.textContent = title;
    modalDesc.textContent  = desc;
    modalSrc.src = url;
    modalVideo.load();

    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
  });
});

function closePlayer() {
  modalVideo.pause();
  modal.classList.add('hidden');
  modal.classList.remove('flex');
  document.body.style.overflow = '';
  playIcon.classList.remove('hidden');
  pauseIcon.classList.add('hidden');
}

closeModal.addEventListener('click', closePlayer);
modal.addEventListener('click', (e) => { if (e.target === modal) closePlayer(); });
document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closePlayer(); });

playBtn.addEventListener('click', () => {
  if (modalVideo.paused) { modalVideo.play(); }
  else { modalVideo.pause(); }
});

modalVideo.addEventListener('play',  () => { playIcon.classList.add('hidden'); pauseIcon.classList.remove('hidden'); });
modalVideo.addEventListener('pause', () => { playIcon.classList.remove('hidden'); pauseIcon.classList.add('hidden'); });

modalVideo.addEventListener('loadedmetadata', () => {
  durEl.textContent = fmtTime(modalVideo.duration);
});

modalVideo.addEventListener('timeupdate', () => {
  if (!modalVideo.duration) return;
  const pct = (modalVideo.currentTime / modalVideo.duration) * 100;
  progFill.style.width  = pct + '%';
  progThumb.style.left  = pct + '%';
  curTime.textContent   = fmtTime(modalVideo.currentTime);
});

progTrack.addEventListener('click', (e) => {
  const rect = progTrack.getBoundingClientRect();
  const pct  = (e.clientX - rect.left) / rect.width;
  modalVideo.currentTime = pct * modalVideo.duration;
});

skipBack.addEventListener('click', () => { modalVideo.currentTime = Math.max(0, modalVideo.currentTime - 10); });
skipFwd.addEventListener('click',  () => { modalVideo.currentTime = Math.min(modalVideo.duration, modalVideo.currentTime + 10); });

volSlider.addEventListener('input', () => {
  modalVideo.volume = parseFloat(volSlider.value);
  modalVideo.muted  = modalVideo.volume === 0;
  syncMuteIcon();
});

muteBtn.addEventListener('click', () => {
  modalVideo.muted = !modalVideo.muted;
  syncMuteIcon();
});

function syncMuteIcon() {
  if (modalVideo.muted || modalVideo.volume === 0) {
    volIcon.classList.add('hidden');
    muteIcon.classList.remove('hidden');
  } else {
    volIcon.classList.remove('hidden');
    muteIcon.classList.add('hidden');
  }
}

speedSel.addEventListener('change', () => {
  modalVideo.playbackRate = parseFloat(speedSel.value);
});

fsBtn.addEventListener('click', () => {
  if (document.fullscreenElement) { document.exitFullscreen(); }
  else { modalVideo.requestFullscreen(); }
});

// Space bar to play/pause when modal is open
document.addEventListener('keydown', (e) => {
  if (!modal.classList.contains('hidden') && e.key === ' ') {
    e.preventDefault();
    if (modalVideo.paused) modalVideo.play(); else modalVideo.pause();
  }
});
</script>
