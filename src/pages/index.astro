---
import StoreLayout    from '../layouts/StoreLayout.astro';
import StoreNav       from '../components/store/StoreNav.astro';
import CartDrawer     from '../components/store/CartDrawer.astro';
import Hero           from '../components/store/Hero.astro';
import Features       from '../components/store/Features.astro';
import Testimonials   from '../components/store/Testimonials.astro';
import ProductCard    from '../components/store/ProductCard.astro';
import StoreFooter    from '../components/store/StoreFooter.astro';
import { getSupabase } from '../lib/supabase';

const supabase = getSupabase();
const { data: products } = await supabase
  .from('products')
  .select('id,slug,name,tagline,price,compare_price,images,is_featured,stock')
  .eq('is_active', true)
  .eq('is_featured', true)
  .limit(3);

const featured = products ?? [];
---

<StoreLayout>
  <StoreNav transparent />
  <CartDrawer />

  <Hero />

  <!-- Featured Products -->
  {featured.length > 0 && (
    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-end justify-between mb-10">
          <div>
            <span class="inline-block px-3 py-1 rounded-full bg-nutries-red-50 text-nutries-red-700 text-sm font-semibold border border-nutries-red-100 mb-3">
              Featured Products
            </span>
            <h2 class="font-display text-4xl font-bold text-nutries-grey-900">Our Top Picks</h2>
          </div>
          <a href="/products" class="hidden sm:flex items-center gap-1 text-nutries-indigo-600 text-sm font-semibold hover:gap-2 transition-all">
            View all →
          </a>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {featured.map(p => (
            <ProductCard
              id={p.id}
              slug={p.slug}
              name={p.name}
              tagline={p.tagline}
              price={p.price}
              comparePrice={p.compare_price}
              image={p.images?.[0]}
              isFeatured={p.is_featured}
              stock={p.stock}
            />
          ))}
        </div>
        <div class="text-center mt-10 sm:hidden">
          <a href="/products" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-nutries-indigo-600 text-white font-semibold text-sm hover:bg-nutries-indigo-700 transition-colors">
            View All Products →
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- Dual CTA banner -->
  <section class="py-16 bg-gradient-to-r from-nutries-indigo-900 via-nutries-indigo-800 to-nutries-green-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-6">
        <div class="relative overflow-hidden rounded-3xl bg-white/10 border border-white/20 backdrop-blur-sm p-8">
          <div class="absolute -top-8 -right-8 w-32 h-32 bg-nutries-red-500/20 rounded-full blur-2xl"></div>
          <span class="inline-block px-3 py-1 rounded-full bg-nutries-red-500 text-white text-xs font-bold mb-4">Best Seller</span>
          <h3 class="font-display text-2xl font-bold text-white mb-2">Chef Preserve Compact Vacuum Sealer</h3>
          <p class="text-white/60 text-sm mb-6">The countertop essential for every home kitchen.</p>
          <div class="flex items-center gap-4">
            <span class="text-3xl font-bold text-white">$149.99</span>
            <span class="text-white/40 line-through">$199.99</span>
          </div>
          <a href="/products/chef-preserve-compact-vacuum-sealer"
            class="mt-5 inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-btn-red text-white font-semibold text-sm hover:shadow-glow-r transition-all">
            Shop Now →
          </a>
        </div>
        <div class="relative overflow-hidden rounded-3xl bg-white/10 border border-white/20 backdrop-blur-sm p-8">
          <div class="absolute -top-8 -right-8 w-32 h-32 bg-nutries-green-500/20 rounded-full blur-2xl"></div>
          <span class="inline-block px-3 py-1 rounded-full bg-nutries-green-600 text-white text-xs font-bold mb-4">Best Value</span>
          <h3 class="font-display text-2xl font-bold text-white mb-2">Chef Preserve Pro Bundle</h3>
          <p class="text-white/60 text-sm mb-6">Sealer + 100 premium bags — save $100 vs. buying separately.</p>
          <div class="flex items-center gap-4">
            <span class="text-3xl font-bold text-white">$199.99</span>
            <span class="text-white/40 line-through">$299.97</span>
          </div>
          <a href="/products/chef-preserve-pro-bundle"
            class="mt-5 inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-btn-green text-white font-semibold text-sm hover:shadow-glow-g transition-all">
            Shop Bundle →
          </a>
        </div>
      </div>
    </div>
  </section>

  <Features />

  <!-- Freshness comparison -->
  <section class="py-20 bg-nutries-grey-900 text-white overflow-hidden relative">
    <div class="absolute inset-0 opacity-5"
      style="background-image: radial-gradient(circle, rgba(255,255,255,0.5) 1px, transparent 1px); background-size: 30px 30px;">
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <h2 class="font-display text-4xl sm:text-5xl font-bold mb-4">See the Difference</h2>
        <p class="text-white/50 text-lg max-w-xl mx-auto">Vacuum sealing locks air out — and freshness in.</p>
      </div>
      <div class="grid md:grid-cols-2 gap-6 max-w-4xl mx-auto">
        <div class="rounded-2xl bg-white/5 border border-white/10 p-6">
          <div class="flex items-center gap-3 mb-5">
            <span class="w-8 h-8 rounded-full bg-nutries-red-600/30 flex items-center justify-center text-nutries-red-400 font-bold">✗</span>
            <h3 class="font-semibold text-lg">Without Vacuum Sealing</h3>
          </div>
          {[['Beef (refrigerated)','3–5 days'],['Fresh vegetables','3–7 days'],['Cheese','1–2 weeks'],['Fish (frozen)','2–3 months']].map(([f,d]) => (
            <div class="flex justify-between py-3 border-b border-white/10 last:border-0">
              <span class="text-white/60 text-sm">{f}</span>
              <span class="text-nutries-red-400 text-sm font-medium">{d}</span>
            </div>
          ))}
        </div>
        <div class="rounded-2xl bg-nutries-green-900/40 border border-nutries-green-700/30 p-6">
          <div class="flex items-center gap-3 mb-5">
            <span class="w-8 h-8 rounded-full bg-nutries-green-600/40 flex items-center justify-center text-nutries-green-400 font-bold">✓</span>
            <h3 class="font-semibold text-lg">With Chef Preserve</h3>
          </div>
          {[['Beef (refrigerated)','Up to 2 weeks'],['Fresh vegetables','2–3 weeks'],['Cheese','4–8 weeks'],['Fish (frozen)','1–2 years']].map(([f,d]) => (
            <div class="flex justify-between py-3 border-b border-white/10 last:border-0">
              <span class="text-white/60 text-sm">{f}</span>
              <span class="text-nutries-green-400 text-sm font-bold">{d}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <Testimonials />

  <!-- Final CTA -->
  <section class="py-20 bg-section-warm">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <h2 class="font-display text-4xl sm:text-5xl font-bold text-nutries-grey-900 mb-4">Ready to Seal the Deal?</h2>
      <p class="text-nutries-grey-500 text-lg mb-8">
        Join thousands of home cooks saving money, reducing waste, and eating fresher every day.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/products/chef-preserve-compact-vacuum-sealer"
          class="px-8 py-4 rounded-2xl bg-btn-red text-white font-bold text-lg hover:shadow-glow-r transition-all hover:-translate-y-1">
          Shop the Sealer — $149.99
        </a>
        <a href="/products"
          class="px-8 py-4 rounded-2xl border-2 border-nutries-indigo-200 text-nutries-indigo-700 font-bold text-lg hover:bg-nutries-indigo-50 transition-all">
          Browse All Products
        </a>
      </div>
      <p class="mt-6 text-nutries-grey-400 text-sm">Free shipping over $75 · 30-day returns · 2-year warranty</p>
    </div>
  </section>

  <StoreFooter />
</StoreLayout>
