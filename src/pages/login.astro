---
import Layout from '../layouts/Layout.astro';
import { getSessionFromCookies } from '../lib/supabase';

// Redirect if already logged in
const { user } = await getSessionFromCookies(Astro.cookies);
if (user) return Astro.redirect('/dashboard');

const message = Astro.url.searchParams.get('message');
const error   = Astro.url.searchParams.get('error');
---

<Layout title="Log In — AkinsMedia">
  <div class="min-h-screen bg-slate-50 flex flex-col">

    <!-- Top bar -->
    <div class="py-5 px-6 border-b border-slate-200 bg-white">
      <a href="/" class="inline-flex items-center gap-2 group">
        <div class="w-7 h-7 bg-brand-900 rounded-lg flex items-center justify-center">
          <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 14.25h13.5m-13.5 0a3 3 0 01-3-3m3 3a3 3 0 100 6h13.5a3 3 0 100-6m-16.5-3a3 3 0 013-3h13.5a3 3 0 013 3m-19.5 0a4.5 4.5 0 01.9-2.7L5.737 5.1a3.375 3.375 0 012.7-1.35h7.126c1.062 0 2.062.5 2.7 1.35l2.587 3.45a4.5 4.5 0 01.9 2.7m0 0a3 3 0 01-3 3m0 3h.008v.008h-.008v-.008zm0-6h.008v.008h-.008v-.008zm-3 6h.008v.008h-.008v-.008zm0-6h.008v.008h-.008v-.008z" />
          </svg>
        </div>
        <span class="font-bold text-brand-900">AkinsMedia</span>
      </a>
    </div>

    <!-- Card -->
    <div class="flex-1 flex items-center justify-center px-4 py-12">
      <div class="w-full max-w-md">

        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-8">

          <h1 class="text-2xl font-extrabold text-slate-900 mb-1">
            {message === 'check-email' ? 'Check your inbox' : 'Welcome back'}
          </h1>
          <p class="text-sm text-slate-500 mb-6">
            {message === 'check-email'
              ? 'We sent you a confirmation email — click the link inside to activate your account, then log in below.'
              : 'Log in to access your trainings'}
          </p>

          <!-- Messages -->
          {message === 'check-email' && (
            <div class="mb-4 p-3 bg-blue-50 border border-blue-200 rounded-lg text-sm text-blue-800">
              Check your email to confirm your account, then log in.
            </div>
          )}
          {error && (
            <div class="mb-4 p-3 bg-red-50 border border-red-200 rounded-lg text-sm text-red-700" id="error-msg">
              {decodeURIComponent(error)}
            </div>
          )}

          <!-- Form -->
          <form id="login-form" method="POST" action="/api/auth/login" class="space-y-4">

            <div>
              <label for="email" class="block text-sm font-medium text-slate-700 mb-1">Email</label>
              <input
                id="email" name="email" type="email" required autocomplete="email"
                placeholder="you@example.com"
                class="w-full px-4 py-2.5 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition"
              />
            </div>

            <div>
              <label for="password" class="block text-sm font-medium text-slate-700 mb-1">Password</label>
              <input
                id="password" name="password" type="password" required autocomplete="current-password"
                placeholder="••••••••"
                class="w-full px-4 py-2.5 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition"
              />
            </div>

            <button
              type="submit"
              class="w-full py-3 px-4 bg-brand-700 hover:bg-brand-800 text-white font-semibold rounded-xl text-sm transition-colors shadow-sm flex items-center justify-center gap-2"
              id="submit-btn"
            >
              Log In
            </button>

          </form>

          <p class="mt-6 text-center text-sm text-slate-500">
            Don't have an account?
            <a href="/signup" class="font-semibold text-brand-700 hover:text-brand-800 ml-1">Get started free</a>
          </p>

        </div>

      </div>
    </div>

  </div>
</Layout>

<script>
  const form = document.getElementById('login-form') as HTMLFormElement;
  const btn  = document.getElementById('submit-btn') as HTMLButtonElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    btn.disabled = true;
    btn.textContent = 'Logging in…';

    const res = await fetch('/api/auth/login', {
      method: 'POST',
      body: new FormData(form),
    });

    if (res.redirected) {
      window.location.href = res.url;
      return;
    }

    const data = await res.json().catch(() => ({ error: 'Unexpected error' }));
    btn.disabled = false;
    btn.textContent = 'Log In';

    let errBox = document.getElementById('error-msg');
    if (!errBox) {
      errBox = document.createElement('div');
      errBox.id = 'error-msg';
      errBox.className = 'mb-4 p-3 bg-red-50 border border-red-200 rounded-lg text-sm text-red-700';
      form.prepend(errBox);
    }
    errBox.textContent = data.error ?? 'Login failed. Please try again.';
  });
</script>
