---
import StoreLayout from '../layouts/StoreLayout.astro';
import { getSessionFromCookies, isAdmin } from '../lib/supabase';

const { user } = await getSessionFromCookies(Astro.cookies);
if (user) return Astro.redirect(isAdmin(user.email) ? '/admin' : '/dashboard');

const error = Astro.url.searchParams.get('error');

const supabaseUrl     = import.meta.env.SUPABASE_URL;
const supabaseAnonKey = import.meta.env.SUPABASE_ANON_KEY;
---

<StoreLayout title="Sign In — Nutries">
  <div class="min-h-screen flex">

    <!-- Left hero panel -->
    <div class="hidden lg:flex lg:w-1/2 relative flex-col justify-between p-10 overflow-hidden"
         style="background: linear-gradient(135deg, #3730a3 0%, #166534 100%);">

      <!-- Subtle overlay pattern -->
      <div class="absolute inset-0 opacity-10"
           style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 32px 32px;"></div>

      <!-- Logo -->
      <div class="relative z-10 flex items-center gap-3">
        <div class="w-10 h-10 bg-white/20 backdrop-blur rounded-xl flex items-center justify-center">
          <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m12.728 0l-.707-.707M6.343 6.343l-.707-.707M12 8a4 4 0 100 8 4 4 0 000-8z"/>
          </svg>
        </div>
        <span class="text-white font-display font-bold text-xl tracking-tight">Nutries</span>
      </div>

      <!-- Centre content -->
      <div class="relative z-10">
        <h2 class="text-white font-display font-bold text-4xl leading-tight mb-4">
          Fresh food.<br/>Less waste.<br/>Every day.
        </h2>
        <p class="text-white/70 text-base leading-relaxed max-w-xs">
          Premium vacuum-sealing solutions that keep your food fresher, longer — and your kitchen smarter.
        </p>

        <!-- Product image -->
        <div class="mt-8 rounded-2xl overflow-hidden shadow-glass max-w-sm">
          <img src="/images/products/product-salmon.jpg" alt="Fresh preserved salmon" class="w-full h-56 object-cover"/>
        </div>

        <!-- Trust badges -->
        <div class="mt-8 flex flex-wrap gap-4">
          {['Free shipping over $50', '30-day returns', 'Lifetime warranty'].map(t => (
            <div class="flex items-center gap-1.5 text-white/80 text-sm">
              <svg class="w-4 h-4 text-nutries-green-300" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"/>
              </svg>
              {t}
            </div>
          ))}
        </div>
      </div>

      <p class="relative z-10 text-white/40 text-xs">&copy; {new Date().getFullYear()} Nutries. All rights reserved.</p>
    </div>

    <!-- Right auth panel -->
    <div class="flex-1 flex items-center justify-center px-6 py-12 bg-white">
      <div class="w-full max-w-md">

        <!-- Mobile logo -->
        <div class="flex items-center gap-2 mb-8 lg:hidden">
          <div class="w-8 h-8 bg-nutries-indigo-600 rounded-lg flex items-center justify-center">
            <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m12.728 0l-.707-.707M6.343 6.343l-.707-.707M12 8a4 4 0 100 8 4 4 0 000-8z"/>
            </svg>
          </div>
          <span class="font-display font-bold text-nutries-grey-900 text-lg">Nutries</span>
        </div>

        <h1 class="font-display text-2xl font-bold text-nutries-grey-900 mb-1">Welcome back</h1>
        <p class="text-nutries-grey-400 text-sm mb-8">Sign in to your Nutries account</p>

        {error && (
          <div class="mb-6 p-3.5 bg-red-50 border border-red-200 rounded-xl text-sm text-red-700">
            {decodeURIComponent(error)}
          </div>
        )}

        <!-- 1. Google Sign In -->
        <a
          href="/api/auth/google"
          class="w-full flex items-center justify-center gap-3 py-3 px-4 bg-white border border-nutries-grey-200 rounded-xl text-nutries-grey-700 font-semibold text-sm hover:bg-nutries-grey-50 hover:shadow-sm transition-all mb-4"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
          </svg>
          Continue with Google
        </a>

        <!-- Divider -->
        <div class="flex items-center gap-3 my-5">
          <div class="flex-1 h-px bg-nutries-grey-100"></div>
          <span class="text-nutries-grey-400 text-xs font-medium">or continue with</span>
          <div class="flex-1 h-px bg-nutries-grey-100"></div>
        </div>

        <!-- 2. Magic Link -->
        <div class="mb-5">
          <div id="magic-success" class="hidden mb-3 p-3.5 bg-nutries-green-50 border border-nutries-green-200 rounded-xl text-sm text-nutries-green-700">
            Magic link sent! Check your inbox and click the link to sign in.
          </div>
          <div class="flex gap-2">
            <input
              id="magic-email"
              type="email"
              placeholder="your@email.com"
              class="flex-1 px-4 py-3 rounded-xl border border-nutries-grey-200 text-sm focus:outline-none focus:ring-2 focus:ring-nutries-indigo-300 transition"
            />
            <button
              id="magic-btn"
              type="button"
              class="px-4 py-3 rounded-xl bg-nutries-indigo-50 text-nutries-indigo-700 font-semibold text-sm hover:bg-nutries-indigo-100 transition whitespace-nowrap"
            >
              Send Link
            </button>
          </div>
        </div>

        <!-- Divider -->
        <div class="flex items-center gap-3 my-5">
          <div class="flex-1 h-px bg-nutries-grey-100"></div>
          <span class="text-nutries-grey-400 text-xs font-medium">or sign in with password</span>
          <div class="flex-1 h-px bg-nutries-grey-100"></div>
        </div>

        <!-- 3. Email + Password -->
        <form id="login-form" class="space-y-4">
          <div id="pw-error" class="hidden p-3.5 bg-red-50 border border-red-200 rounded-xl text-sm text-red-700"></div>

          <div>
            <label for="email" class="block text-xs font-semibold text-nutries-grey-700 mb-1.5 uppercase tracking-wide">Email</label>
            <input
              id="email" name="email" type="email" required autocomplete="email"
              placeholder="you@example.com"
              class="w-full px-4 py-3 rounded-xl border border-nutries-grey-200 text-sm focus:outline-none focus:ring-2 focus:ring-nutries-indigo-300 transition"
            />
          </div>

          <div>
            <label for="password" class="block text-xs font-semibold text-nutries-grey-700 mb-1.5 uppercase tracking-wide">Password</label>
            <input
              id="password" name="password" type="password" required autocomplete="current-password"
              placeholder="••••••••"
              class="w-full px-4 py-3 rounded-xl border border-nutries-grey-200 text-sm focus:outline-none focus:ring-2 focus:ring-nutries-indigo-300 transition"
            />
          </div>

          <button
            type="submit"
            id="submit-btn"
            class="w-full py-3 px-4 rounded-xl bg-btn-indigo text-white font-bold text-sm hover:shadow-glow-i transition-all hover:-translate-y-0.5"
          >
            Sign In
          </button>
        </form>

        <p class="mt-8 text-center text-sm text-nutries-grey-400">
          Don't have an account?
          <a href="/signup" class="font-semibold text-nutries-indigo-600 hover:text-nutries-indigo-700 ml-1">Create one free</a>
        </p>

      </div>
    </div>
  </div>
</StoreLayout>

<!-- Config passed to client via data attributes -->
<div id="sb-config" data-url={supabaseUrl} data-key={supabaseAnonKey} style="display:none"></div>

<!-- Email + Password login — no external dependencies -->
<script is:inline>
  (function () {
    var form = document.getElementById('login-form');
    if (!form) return;
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var submitBtn = document.getElementById('submit-btn');
      var errBox    = document.getElementById('pw-error');
      submitBtn.disabled    = true;
      submitBtn.textContent = 'Signing in…';

      fetch('/api/auth/login', { method: 'POST', body: new FormData(form) })
        .then(function (res) {
          if (res.redirected) { window.location.href = res.url; return; }
          return res.json().then(function (data) {
            submitBtn.disabled    = false;
            submitBtn.textContent = 'Sign In';
            errBox.textContent    = data.error || 'Login failed. Please try again.';
            errBox.classList.remove('hidden');
          });
        })
        .catch(function () {
          submitBtn.disabled    = false;
          submitBtn.textContent = 'Sign In';
          errBox.textContent    = 'Network error. Please try again.';
          errBox.classList.remove('hidden');
        });
    });
  })();
</script>

<!-- Magic Link — Supabase CDN loads synchronously (no async/defer), then inline script runs -->
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.js"></script>
<script is:inline>
  (function () {
    var cfg    = document.getElementById('sb-config');
    var sbUrl  = cfg && cfg.dataset.url;
    var sbKey  = cfg && cfg.dataset.key;
    if (!sbUrl || !sbKey || !window.supabase) return;

    var sb     = window.supabase.createClient(sbUrl, sbKey);
    var origin = window.location.origin;

    var magicBtn = document.getElementById('magic-btn');
    if (!magicBtn) return;
    magicBtn.addEventListener('click', function () {
      var emailInput = document.getElementById('magic-email');
      var successEl  = document.getElementById('magic-success');
      var errBox     = document.getElementById('pw-error');
      var email      = emailInput.value.trim();
      if (!email) { emailInput.focus(); return; }

      magicBtn.disabled    = true;
      magicBtn.textContent = 'Sending…';

      sb.auth.signInWithOtp({ email: email, options: { emailRedirectTo: origin + '/auth/callback' } })
        .then(function (result) {
          magicBtn.disabled    = false;
          magicBtn.textContent = 'Send Link';
          if (result.error) {
            errBox.textContent = result.error.message;
            errBox.classList.remove('hidden');
          } else {
            successEl.classList.remove('hidden');
            emailInput.value = '';
          }
        });
    });
  })();
</script>
