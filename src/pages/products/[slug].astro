---
import StoreLayout from '../../layouts/StoreLayout.astro';
import StoreNav    from '../../components/store/StoreNav.astro';
import CartDrawer  from '../../components/store/CartDrawer.astro';
import ProductCard from '../../components/store/ProductCard.astro';
import StoreFooter from '../../components/store/StoreFooter.astro';
import { getSupabase } from '../../lib/supabase';

const { slug } = Astro.params;
const supabase  = getSupabase();

const { data: product } = await supabase
  .from('products')
  .select('*')
  .eq('slug', slug)
  .eq('is_active', true)
  .single();

if (!product) return Astro.redirect('/products');

// Related products (same category, different slug)
const { data: related } = await supabase
  .from('products')
  .select('id,slug,name,tagline,price,compare_price,images,is_featured,stock')
  .eq('is_active', true)
  .eq('category', product.category)
  .neq('slug', slug)
  .limit(3);

const discount = product.compare_price
  ? Math.round(((product.compare_price - product.price) / product.compare_price) * 100)
  : null;
---

<StoreLayout
  title={`${product.name} — Nutries`}
  description={product.tagline || product.description?.slice(0, 160)}
>
  <StoreNav />
  <CartDrawer />

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-nutries-grey-400 mb-8">
      <a href="/" class="hover:text-nutries-indigo-600 transition-colors">Home</a>
      <span>/</span>
      <a href="/products" class="hover:text-nutries-indigo-600 transition-colors">Products</a>
      <span>/</span>
      <span class="text-nutries-grey-700 font-medium line-clamp-1">{product.name}</span>
    </nav>

    <!-- Product hero -->
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 mb-20">

      <!-- Image gallery -->
      <div class="space-y-4">
        <div class="relative aspect-square rounded-3xl overflow-hidden bg-gradient-to-br from-nutries-grey-50 to-nutries-indigo-50 border border-nutries-grey-100">
          <img
            id="main-img"
            src={product.images?.[0] || '/images/product-placeholder.svg'}
            alt={product.name}
            class="w-full h-full object-contain p-12"
          />
          <!-- Badges -->
          <div class="absolute top-4 left-4 flex flex-col gap-2">
            {product.is_featured && (
              <span class="px-3 py-1 rounded-full bg-nutries-indigo-600 text-white text-xs font-bold">Best Seller</span>
            )}
            {discount && (
              <span class="px-3 py-1 rounded-full bg-nutries-red-600 text-white text-xs font-bold">Save {discount}%</span>
            )}
          </div>
          <!-- Glossy highlight -->
          <div class="absolute inset-0 bg-gradient-to-br from-white/10 via-transparent to-transparent pointer-events-none"></div>
        </div>
        <!-- Thumbnails -->
        {product.images && product.images.length > 1 && (
          <div class="flex gap-3 overflow-x-auto pb-1">
            {product.images.map((img: string, i: number) => (
              <button
                class="thumb-btn flex-shrink-0 w-20 h-20 rounded-xl overflow-hidden border-2 border-nutries-grey-200 hover:border-nutries-indigo-400 transition-colors"
                data-src={img}
              >
                <img src={img} alt={`View ${i+1}`} class="w-full h-full object-cover"/>
              </button>
            ))}
          </div>
        )}
      </div>

      <!-- Product info -->
      <div>
        <!-- Category pill -->
        <span class="inline-block px-3 py-1 rounded-full bg-nutries-indigo-50 text-nutries-indigo-700 text-xs font-semibold border border-nutries-indigo-100 mb-4 capitalize">
          {product.category.replace(/-/g, ' ')}
        </span>

        <h1 class="font-display text-3xl sm:text-4xl font-bold text-nutries-grey-900 mb-2 leading-tight">
          {product.name}
        </h1>
        {product.tagline && (
          <p class="text-nutries-grey-500 text-lg mb-5">{product.tagline}</p>
        )}

        <!-- Stars -->
        <div class="flex items-center gap-2 mb-5">
          <div class="flex gap-0.5">
            {[1,2,3,4,5].map(() => (
              <svg class="w-4 h-4 text-amber-400 fill-current" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            ))}
          </div>
          <span class="text-nutries-grey-700 font-semibold text-sm">4.9</span>
          <span class="text-nutries-grey-400 text-sm">(127 reviews)</span>
          <a href="#reviews" class="text-nutries-indigo-600 text-sm hover:underline">See all reviews</a>
        </div>

        <!-- Price -->
        <div class="flex items-baseline gap-3 mb-6">
          <span class="text-4xl font-bold text-nutries-grey-900">${product.price.toFixed(2)}</span>
          {product.compare_price && (
            <span class="text-xl text-nutries-grey-400 line-through">${product.compare_price.toFixed(2)}</span>
          )}
          {discount && (
            <span class="px-2 py-0.5 rounded-lg bg-nutries-red-100 text-nutries-red-700 text-sm font-bold">
              You save {discount}%
            </span>
          )}
        </div>

        <!-- Stock indicator -->
        <div class="flex items-center gap-2 mb-6">
          {product.stock > 10 ? (
            <><span class="w-2.5 h-2.5 rounded-full bg-nutries-green-500 animate-pulse"></span>
            <span class="text-nutries-green-700 text-sm font-medium">In Stock</span></>
          ) : product.stock > 0 ? (
            <><span class="w-2.5 h-2.5 rounded-full bg-nutries-brown-500"></span>
            <span class="text-nutries-brown-700 text-sm font-medium">Only {product.stock} left</span></>
          ) : (
            <><span class="w-2.5 h-2.5 rounded-full bg-nutries-red-500"></span>
            <span class="text-nutries-red-700 text-sm font-medium">Out of Stock</span></>
          )}
        </div>

        <!-- Quantity + Add to Cart -->
        <div class="flex gap-3 mb-6">
          <div class="flex items-center gap-0 rounded-xl border border-nutries-grey-200 overflow-hidden">
            <button id="qty-dec" class="px-4 py-3 text-nutries-grey-600 hover:bg-nutries-grey-100 transition-colors text-lg font-bold">-</button>
            <span id="qty-display" class="px-4 py-3 text-nutries-grey-900 font-bold text-base min-w-[3rem] text-center border-x border-nutries-grey-200">1</span>
            <button id="qty-inc" class="px-4 py-3 text-nutries-grey-600 hover:bg-nutries-grey-100 transition-colors text-lg font-bold">+</button>
          </div>

          <button
            id="add-to-cart-btn"
            disabled={product.stock === 0}
            class="flex-1 py-3 px-6 rounded-xl bg-btn-red text-white font-bold text-base shadow-md hover:shadow-glow-r transition-all duration-200 hover:-translate-y-0.5 disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:translate-y-0"
            data-id={product.id}
            data-slug={product.slug}
            data-name={product.name}
            data-price={product.price}
            data-image={product.images?.[0] || '/images/product-placeholder.svg'}
          >
            {product.stock > 0 ? 'Add to Cart' : 'Out of Stock'}
          </button>
        </div>

        <!-- Buy now -->
        {product.stock > 0 && (
          <a
            id="buy-now-btn"
            href="/checkout"
            class="block w-full text-center py-3 px-6 rounded-xl bg-btn-indigo text-white font-bold text-base shadow-md hover:shadow-glow-i transition-all duration-200 hover:-translate-y-0.5 mb-6"
          >
            Buy Now
          </a>
        )}

        <!-- Trust micro -->
        <div class="flex flex-wrap gap-4 py-4 border-t border-nutries-grey-100">
          {[
            { icon: '', label: 'Free shipping over $75' },
            { icon: '', label: '30-day free returns' },
            { icon: '', label: 'Secure Stripe checkout' },
          ].map(t => (
            <div class="flex items-center gap-1.5 text-nutries-grey-500 text-xs">
              <span>{t.icon}</span>{t.label}
            </div>
          ))}
        </div>

        <!-- Description -->
        <div class="mt-6 prose prose-sm max-w-none text-nutries-grey-600">
          <p class="leading-relaxed">{product.description}</p>
        </div>

        <!-- Features list -->
        {product.features && product.features.length > 0 && (
          <div class="mt-6 space-y-2">
            <h3 class="font-semibold text-nutries-grey-900 text-sm uppercase tracking-wide mb-3">What's Included</h3>
            {product.features.map((f: string) => (
              <div class="flex items-start gap-2.5">
                <svg class="w-4 h-4 text-nutries-green-600 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"/>
                </svg>
                <span class="text-nutries-grey-600 text-sm">{f}</span>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>

    <!-- Reviews section -->
    <section id="reviews" class="mb-20">
      <h2 class="font-display text-3xl font-bold text-nutries-grey-900 mb-8">Customer Reviews</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {[
          { name:'Amara O. — London, UK', rating:5, title:'Best kitchen investment I have made', body:"I batch-cook on Sundays and this has halved my food waste. Asparagus stays crisp all week, meat lasts 3× longer. The one-button design means the whole family uses it.", verified:true },
          { name:'Kenji M. — Tokyo, Japan', rating:5, title:'Exceptional performance, zero compromise', body:"Sealed fresh tuna and it was still sashimi-grade 11 days later. The motor is genuinely whisper-quiet. Exactly what was advertised — rare these days.", verified:true },
          { name:'Luca F. — Milan, Italy', rating:5, title:'Sous-vide ready, restaurant quality', body:"I sous-vide regularly and this handles wet marinades as well as dry goods. The moist-mode auto-detection is the detail that sets it apart from everything else I tried.", verified:true },
        ].map(r => (
          <div class="bg-nutries-grey-50 rounded-2xl p-5 border border-nutries-grey-100">
            <div class="flex gap-0.5 mb-2">
              {[1,2,3,4,5].map(() => (
                <svg class="w-3.5 h-3.5 text-amber-400 fill-current" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              ))}
            </div>
            <h4 class="font-bold text-nutries-grey-900 text-sm mb-1">"{r.title}"</h4>
            <p class="text-nutries-grey-500 text-xs leading-relaxed">{r.body}</p>
            <div class="flex items-center gap-2 mt-4 pt-3 border-t border-nutries-grey-200">
              <div class="w-7 h-7 rounded-full bg-nutries-indigo-600 flex items-center justify-center text-white text-xs font-bold">
                {r.name[0]}
              </div>
              <span class="text-nutries-grey-700 text-xs font-medium">{r.name}</span>
              {r.verified && <span class="ml-auto text-nutries-green-600 text-xs font-medium flex items-center gap-1">
                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"/></svg>
                Verified
              </span>}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Related products -->
    {related && related.length > 0 && (
      <section>
        <h2 class="font-display text-3xl font-bold text-nutries-grey-900 mb-8">You Might Also Like</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {related.map(p => (
            <ProductCard
              id={p.id}
              slug={p.slug}
              name={p.name}
              tagline={p.tagline}
              price={p.price}
              comparePrice={p.compare_price}
              image={p.images?.[0]}
              isFeatured={p.is_featured}
              stock={p.stock}
            />
          ))}
        </div>
      </section>
    )}
  </main>

  <StoreFooter />

  <script is:inline>
(function () {
  var qty = 1;
  var qtyDisplay = document.getElementById('qty-display');

  var decBtn = document.getElementById('qty-dec');
  var incBtn = document.getElementById('qty-inc');
  if (decBtn) decBtn.addEventListener('click', function () {
    if (qty > 1) { qty--; if (qtyDisplay) qtyDisplay.textContent = String(qty); }
  });
  if (incBtn) incBtn.addEventListener('click', function () {
    if (qty < 99) { qty++; if (qtyDisplay) qtyDisplay.textContent = String(qty); }
  });

  var addBtn = document.getElementById('add-to-cart-btn');
  if (addBtn) addBtn.addEventListener('click', function () {
    window.NutriesCart && window.NutriesCart.add({
      id:    addBtn.dataset.id,
      slug:  addBtn.dataset.slug,
      name:  addBtn.dataset.name,
      price: parseFloat(addBtn.dataset.price),
      image: addBtn.dataset.image,
      qty:   qty,
    });
    addBtn.textContent = 'Added to Cart!';
    addBtn.classList.add('bg-nutries-green-600');
    setTimeout(function () {
      addBtn.textContent = 'Add to Cart';
      addBtn.classList.remove('bg-nutries-green-600');
    }, 1800);
    document.dispatchEvent(new CustomEvent('cart:open'));
  });

  var buyNowBtn = document.getElementById('buy-now-btn');
  if (buyNowBtn) buyNowBtn.addEventListener('click', function (e) {
    e.preventDefault();
    if (addBtn) addBtn.click();
    setTimeout(function () { window.location.href = '/checkout'; }, 400);
  });

  document.querySelectorAll('.thumb-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var mainImg = document.getElementById('main-img');
      if (mainImg) mainImg.src = btn.dataset.src;
    });
  });
})();
  </script>
</StoreLayout>
