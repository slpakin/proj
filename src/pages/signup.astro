---
import StoreLayout from '../layouts/StoreLayout.astro';
import { getSessionFromCookies, isAdmin } from '../lib/supabase';

const { user } = await getSessionFromCookies(Astro.cookies);
if (user) return Astro.redirect(isAdmin(user.email) ? '/admin' : '/dashboard');
---

<StoreLayout title="Create Account — Nutries">
  <div class="min-h-screen flex">

    <!-- Left hero panel -->
    <div class="hidden lg:flex lg:w-1/2 relative flex-col justify-between p-10 overflow-hidden"
         style="background: linear-gradient(135deg, #166534 0%, #3730a3 100%);">

      <div class="absolute inset-0 opacity-10"
           style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 32px 32px;"></div>

      <!-- Logo -->
      <div class="relative z-10 flex items-center gap-3">
        <div class="w-10 h-10 bg-white/20 backdrop-blur rounded-xl flex items-center justify-center">
          <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m12.728 0l-.707-.707M6.343 6.343l-.707-.707M12 8a4 4 0 100 8 4 4 0 000-8z"/>
          </svg>
        </div>
        <span class="text-white font-display font-bold text-xl tracking-tight">Nutries</span>
      </div>

      <!-- Centre content -->
      <div class="relative z-10">
        <h2 class="text-white font-display font-bold text-4xl leading-tight mb-4">
          Join thousands<br/>of smart<br/>home cooks.
        </h2>
        <p class="text-white/70 text-base leading-relaxed max-w-xs">
          Create your free account and start saving money on groceries with professional-grade food preservation.
        </p>

        <div class="mt-8 rounded-2xl overflow-hidden shadow-glass max-w-sm">
          <img src="/images/products/product-salmon.jpg" alt="Fresh preserved food" class="w-full h-56 object-cover"/>
        </div>

        <div class="mt-8 flex flex-col gap-3">
          {['No credit card required', 'Free shipping on your first order', 'Join 12,000+ happy customers'].map(t => (
            <div class="flex items-center gap-2 text-white/80 text-sm">
              <svg class="w-4 h-4 text-nutries-green-300 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"/>
              </svg>
              {t}
            </div>
          ))}
        </div>
      </div>

      <p class="relative z-10 text-white/40 text-xs">&copy; {new Date().getFullYear()} Nutries. All rights reserved.</p>
    </div>

    <!-- Right auth panel -->
    <div class="flex-1 flex items-center justify-center px-6 py-12 bg-white">
      <div class="w-full max-w-md">

        <!-- Mobile logo -->
        <div class="flex items-center gap-2 mb-8 lg:hidden">
          <div class="w-8 h-8 bg-nutries-green-600 rounded-lg flex items-center justify-center">
            <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m12.728 0l-.707-.707M6.343 6.343l-.707-.707M12 8a4 4 0 100 8 4 4 0 000-8z"/>
            </svg>
          </div>
          <span class="font-display font-bold text-nutries-grey-900 text-lg">Nutries</span>
        </div>

        <h1 class="font-display text-2xl font-bold text-nutries-grey-900 mb-1">Create your account</h1>
        <p class="text-nutries-grey-400 text-sm mb-8">Free to join. No credit card needed.</p>

        <!-- Google Sign In -->
        <a
          href="/api/auth/google"
          class="w-full flex items-center justify-center gap-3 py-3 px-4 bg-white border border-nutries-grey-200 rounded-xl text-nutries-grey-700 font-semibold text-sm hover:bg-nutries-grey-50 hover:shadow-sm transition-all mb-6"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
          </svg>
          Sign up with Google
        </a>

        <!-- Divider -->
        <div class="flex items-center gap-3 mb-6">
          <div class="flex-1 h-px bg-nutries-grey-100"></div>
          <span class="text-nutries-grey-400 text-xs font-medium">or register with email</span>
          <div class="flex-1 h-px bg-nutries-grey-100"></div>
        </div>

        <!-- Signup form -->
        <form id="signup-form" class="space-y-4">
          <div id="form-error" class="hidden p-3.5 bg-red-50 border border-red-200 rounded-xl text-sm text-red-700"></div>

          <div>
            <label for="name" class="block text-xs font-semibold text-nutries-grey-700 mb-1.5 uppercase tracking-wide">Full Name</label>
            <input
              id="name" name="name" type="text" required autocomplete="name"
              placeholder="Jane Smith"
              class="w-full px-4 py-3 rounded-xl border border-nutries-grey-200 text-sm focus:outline-none focus:ring-2 focus:ring-nutries-green-300 transition"
            />
          </div>

          <div>
            <label for="email" class="block text-xs font-semibold text-nutries-grey-700 mb-1.5 uppercase tracking-wide">Email</label>
            <input
              id="email" name="email" type="email" required autocomplete="email"
              placeholder="you@example.com"
              class="w-full px-4 py-3 rounded-xl border border-nutries-grey-200 text-sm focus:outline-none focus:ring-2 focus:ring-nutries-green-300 transition"
            />
          </div>

          <div>
            <label for="password" class="block text-xs font-semibold text-nutries-grey-700 mb-1.5 uppercase tracking-wide">Password</label>
            <input
              id="password" name="password" type="password" required minlength="8" autocomplete="new-password"
              placeholder="Minimum 8 characters"
              class="w-full px-4 py-3 rounded-xl border border-nutries-grey-200 text-sm focus:outline-none focus:ring-2 focus:ring-nutries-green-300 transition"
            />
          </div>

          <button
            type="submit"
            id="submit-btn"
            class="w-full py-3 px-4 rounded-xl bg-btn-green text-white font-bold text-sm hover:shadow-glow-g transition-all hover:-translate-y-0.5"
          >
            Create Account
          </button>

          <p class="text-xs text-nutries-grey-400 text-center">
            By creating an account you agree to our
            <a href="/privacy" class="text-nutries-indigo-600 hover:underline">Privacy Policy</a>.
          </p>
        </form>

        <p class="mt-8 text-center text-sm text-nutries-grey-400">
          Already have an account?
          <a href="/login" class="font-semibold text-nutries-indigo-600 hover:text-nutries-indigo-700 ml-1">Sign in</a>
        </p>

      </div>
    </div>
  </div>
</StoreLayout>

<script is:inline>
  (function () {
    var form = document.getElementById('signup-form');
    if (!form) return;
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var submitBtn = document.getElementById('submit-btn');
      var errBox    = document.getElementById('form-error');
      submitBtn.disabled    = true;
      submitBtn.textContent = 'Creating account…';

      fetch('/api/auth/signup', { method: 'POST', body: new FormData(form) })
        .then(function (res) {
          if (res.redirected) { window.location.href = res.url; return; }
          return res.json().then(function (data) {
            submitBtn.disabled    = false;
            submitBtn.textContent = 'Create Account';
            errBox.textContent    = data.error || 'Signup failed. Please try again.';
            errBox.classList.remove('hidden');
          });
        })
        .catch(function () {
          submitBtn.disabled    = false;
          submitBtn.textContent = 'Create Account';
          errBox.textContent    = 'Network error. Please try again.';
          errBox.classList.remove('hidden');
        });
    });
  })();
</script>
