---
import Layout from '../layouts/Layout.astro';
import { getSessionFromCookies } from '../lib/supabase';

const { user } = await getSessionFromCookies(Astro.cookies);
if (user) return Astro.redirect('/dashboard');
---

<Layout title="Get Started — AkinsMedia">
  <div class="min-h-screen bg-slate-50 flex flex-col">

    <!-- Top bar -->
    <div class="py-5 px-6 border-b border-slate-200 bg-white">
      <a href="/" class="inline-flex items-center gap-2">
        <div class="w-7 h-7 bg-brand-900 rounded-lg flex items-center justify-center">
          <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 14.25h13.5m-13.5 0a3 3 0 01-3-3m3 3a3 3 0 100 6h13.5a3 3 0 100-6m-16.5-3a3 3 0 013-3h13.5a3 3 0 013 3m-19.5 0a4.5 4.5 0 01.9-2.7L5.737 5.1a3.375 3.375 0 012.7-1.35h7.126c1.062 0 2.062.5 2.7 1.35l2.587 3.45a4.5 4.5 0 01.9 2.7m0 0a3 3 0 01-3 3m0 3h.008v.008h-.008v-.008zm0-6h.008v.008h-.008v-.008zm-3 6h.008v.008h-.008v-.008zm0-6h.008v.008h-.008v-.008z" />
          </svg>
        </div>
        <span class="font-bold text-brand-900">AkinsMedia</span>
      </a>
    </div>

    <div class="flex-1 flex items-center justify-center px-4 py-12">
      <div class="w-full max-w-md">

        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-8">

          <h1 class="text-2xl font-extrabold text-slate-900 mb-1">Create your account</h1>
          <p class="text-sm text-slate-500 mb-6">Start with free access — no credit card needed</p>

          <!-- Form -->
          <form id="signup-form" method="POST" action="/api/auth/signup" class="space-y-4">

            <div>
              <label for="name" class="block text-sm font-medium text-slate-700 mb-1">Full Name</label>
              <input
                id="name" name="name" type="text" required autocomplete="name"
                placeholder="Jane Smith"
                class="w-full px-4 py-2.5 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition"
              />
            </div>

            <div>
              <label for="email" class="block text-sm font-medium text-slate-700 mb-1">Email</label>
              <input
                id="email" name="email" type="email" required autocomplete="email"
                placeholder="you@example.com"
                class="w-full px-4 py-2.5 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition"
              />
            </div>

            <div>
              <label for="password" class="block text-sm font-medium text-slate-700 mb-1">Password</label>
              <input
                id="password" name="password" type="password" required minlength="8" autocomplete="new-password"
                placeholder="Minimum 8 characters"
                class="w-full px-4 py-2.5 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition"
              />
            </div>

            <button
              type="submit" id="submit-btn"
              class="w-full py-3 px-4 bg-brand-700 hover:bg-brand-800 text-white font-semibold rounded-xl text-sm transition-colors shadow-sm"
            >
              Create Account
            </button>

          </form>

          <!-- Trust signals -->
          <div class="mt-5 flex flex-col gap-1.5">
            {['Free first 2 modules', 'No credit card required', 'Instant access after signup'].map(t => (
              <div class="flex items-center gap-2 text-xs text-slate-500">
                <svg class="w-3.5 h-3.5 text-emerald-500" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"/>
                </svg>
                {t}
              </div>
            ))}
          </div>

          <p class="mt-5 text-center text-sm text-slate-500">
            Already have an account?
            <a href="/login" class="font-semibold text-brand-700 hover:text-brand-800 ml-1">Log in</a>
          </p>

        </div>

      </div>
    </div>

  </div>
</Layout>

<script>
  const form = document.getElementById('signup-form') as HTMLFormElement;
  const btn  = document.getElementById('submit-btn') as HTMLButtonElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    btn.disabled = true;
    btn.textContent = 'Creating account…';

    const res = await fetch('/api/auth/signup', {
      method: 'POST',
      body: new FormData(form),
    });

    if (res.redirected) {
      window.location.href = res.url;
      return;
    }

    const data = await res.json().catch(() => ({ error: 'Unexpected error' }));
    btn.disabled = false;
    btn.textContent = 'Create Account';

    let errBox = document.getElementById('error-msg');
    if (!errBox) {
      errBox = document.createElement('div');
      errBox.id = 'error-msg';
      errBox.className = 'mb-4 p-3 bg-red-50 border border-red-200 rounded-lg text-sm text-red-700';
      form.prepend(errBox);
    }
    errBox.textContent = data.error ?? 'Signup failed. Please try again.';
  });
</script>
